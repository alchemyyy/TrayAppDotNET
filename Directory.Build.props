<Project>
  <Import Project="$(MSBuildThisFileDirectory)TrayAppDotNET.Parent.props" />

  <!-- x64-only: Win32 interop and native dependencies require a concrete x64 build. Platforms drives the IDE platform
       picker, PlatformTarget the compiler, and Platform covers command-line builds invoked without one.
       ReleaseWithDebugging is the debuggable Native AOT build (see TrayAppDotNET.Parent.targets). -->
  <PropertyGroup>
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)\obj\$(_TrayAppDotNETProjectExtensionsConfiguration)\</MSBuildProjectExtensionsPath>
    <Configurations Condition="'$(Configurations)' == ''">Debug;Prerelease;Release;ReleaseWithDebugging</Configurations>
    <Platforms Condition="'$(Platforms)' == ''">x64</Platforms>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
  </PropertyGroup>
</Project>
