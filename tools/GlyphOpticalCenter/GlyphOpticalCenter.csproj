<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(TrayAppDotNETAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(TrayAppDotNETAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(TrayAppDotNETAvaloniaVersion)" />
  </ItemGroup>
</Project>
