<!-- Every size, colour, radius and control template the installer draws with. The window builds its layout
     in code, so nothing visual is allowed to be hard-coded there: it all lives here.
     The palette is declared twice, once under the Light. prefix and once under the Dark. prefix. SystemTheme
     copies the set that matches the operating system appearance onto the unprefixed brush keys the styles
     bind to with DynamicResource, and adds the accent brushes it reads from Windows. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Typography -->
    <FontFamily x:Key="InstallerTheme.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <system:Double x:Key="InstallerTheme.BodyFontSize">14</system:Double>
    <system:Double x:Key="InstallerTheme.TitleFontSize">22</system:Double>
    <system:Double x:Key="InstallerTheme.SecondaryFontSize">12</system:Double>

    <!-- Window geometry -->
    <system:Double x:Key="InstallerTheme.WindowWidth">560</system:Double>
    <Thickness x:Key="InstallerTheme.OuterMargin">24</Thickness>

    <!-- Title bar. The window draws its own, because the one Windows draws cannot be made taller for a single
         window. Windows gives this non-resizable window a 30 unit bar, measured; this one is 4 taller. -->
    <system:Double x:Key="InstallerTheme.CaptionHeight">34</system:Double>
    <system:Double x:Key="InstallerTheme.CaptionFontSize">12</system:Double>
    <system:Double x:Key="InstallerTheme.CaptionIconSize">16</system:Double>
    <Thickness x:Key="InstallerTheme.CaptionIconMargin">8,0,8,0</Thickness>
    <system:Double x:Key="InstallerTheme.CaptionButtonWidth">46</system:Double>
    <FontFamily x:Key="InstallerTheme.CaptionGlyphFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <system:Double x:Key="InstallerTheme.CaptionGlyphFontSize">10</system:Double>
    <system:String x:Key="InstallerTheme.CloseGlyph">&#xE8BB;</system:String>
    <!-- A sliver of glass keeps Windows drawing the shadow and the rounded corners. The window paints over it,
         so it never shows. -->
    <Thickness x:Key="InstallerTheme.CaptionGlassFrameThickness">0,0,0,1</Thickness>
    <!-- The close button's red is the same in both appearances, so it sits outside the palette -->
    <SolidColorBrush x:Key="InstallerTheme.CloseHoverBackgroundBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="InstallerTheme.ClosePressedBackgroundBrush" Color="#E6C42B1C" />
    <SolidColorBrush x:Key="InstallerTheme.CloseActiveGlyphBrush" Color="#FFFFFFFF" />

    <!-- Stack spacing, applied as a bottom or right margin on every child but the last -->
    <Thickness x:Key="InstallerTheme.SectionSpacing">0,0,0,20</Thickness>
    <Thickness x:Key="InstallerTheme.ItemSpacing">0,0,0,8</Thickness>
    <Thickness x:Key="InstallerTheme.DescriptionSpacing">0,0,0,2</Thickness>
    <Thickness x:Key="InstallerTheme.InlineSpacing">0,0,12,0</Thickness>
    <Thickness x:Key="InstallerTheme.ButtonSpacing">0,0,8,0</Thickness>
    <Thickness x:Key="InstallerTheme.BrowseButtonMargin">8,0,0,0</Thickness>

    <!-- Controls -->
    <system:Double x:Key="InstallerTheme.ButtonMinWidth">104</system:Double>
    <system:Double x:Key="InstallerTheme.ButtonMinHeight">32</system:Double>
    <Thickness x:Key="InstallerTheme.ButtonPadding">14,5,14,6</Thickness>
    <Thickness x:Key="InstallerTheme.LinkPadding">0,2,0,2</Thickness>
    <!-- NOTE: the box is as tall as the larger of its minimum and one text line plus padding and border, so
         a height change needs both values moved by the same amount -->
    <system:Double x:Key="InstallerTheme.TextBoxMinHeight">28</system:Double>
    <Thickness x:Key="InstallerTheme.TextBoxPadding">10,3,10,4</Thickness>
    <CornerRadius x:Key="InstallerTheme.ControlCornerRadius">4</CornerRadius>
    <Thickness x:Key="InstallerTheme.ControlBorderThickness">1</Thickness>
    <system:Double x:Key="InstallerTheme.FocusUnderlineHeight">2</system:Double>

    <!-- Check box and radio button glyphs -->
    <system:Double x:Key="InstallerTheme.SelectionGlyphSize">20</system:Double>
    <Thickness x:Key="InstallerTheme.SelectionGlyphMargin">0,1,10,0</Thickness>
    <!-- The check box outline is a Border and the radio outline an Ellipse, so the same hairline has to be
         declared once as a Thickness and once as a Double -->
    <Thickness x:Key="InstallerTheme.SelectionGlyphBorderThickness">1</Thickness>
    <system:Double x:Key="InstallerTheme.SelectionGlyphStrokeThickness">1</system:Double>
    <CornerRadius x:Key="InstallerTheme.CheckBoxCornerRadius">4</CornerRadius>
    <system:Double x:Key="InstallerTheme.CheckGlyphThickness">1.6</system:Double>
    <system:Double x:Key="InstallerTheme.RadioDotSize">8</system:Double>

    <!-- Progress -->
    <system:Double x:Key="InstallerTheme.ProgressBarHeight">4</system:Double>
    <CornerRadius x:Key="InstallerTheme.ProgressBarCornerRadius">2</CornerRadius>

    <!-- Windhawk notice -->
    <Thickness x:Key="InstallerTheme.NoticePadding">12</Thickness>
    <CornerRadius x:Key="InstallerTheme.NoticeCornerRadius">4</CornerRadius>
    <Thickness x:Key="InstallerTheme.NoticeBorderThickness">1</Thickness>

    <!-- Application install state, at the right edge of each application row.
         The margin keeps a long name and its battery hint clear of the state. -->
    <Thickness x:Key="InstallerTheme.ApplicationStateMargin">12,0,0,0</Thickness>

    <!-- Accent shading. Windows paints its hover and pressed accent states as the accent colour at reduced
         opacity over the page, which is what these two alphas reproduce. -->
    <system:Double x:Key="InstallerTheme.AccentHoverOpacity">0.9</system:Double>
    <system:Double x:Key="InstallerTheme.AccentPressedOpacity">0.8</system:Double>
    <!-- Used only when Windows exposes no accent colour at all -->
    <Color x:Key="InstallerTheme.AccentFallbackColor">#FF0078D4</Color>

    <!-- Light palette -->
    <Color x:Key="InstallerTheme.Light.WindowBackgroundColor">#FFF3F3F3</Color>
    <Color x:Key="InstallerTheme.Light.PrimaryTextColor">#E4000000</Color>
    <Color x:Key="InstallerTheme.Light.SecondaryTextColor">#9B000000</Color>
    <Color x:Key="InstallerTheme.Light.DisabledTextColor">#5C000000</Color>
    <Color x:Key="InstallerTheme.Light.ControlBackgroundColor">#B3FFFFFF</Color>
    <Color x:Key="InstallerTheme.Light.ControlHoverBackgroundColor">#80F9F9F9</Color>
    <Color x:Key="InstallerTheme.Light.ControlPressedBackgroundColor">#4DF9F9F9</Color>
    <Color x:Key="InstallerTheme.Light.ControlDisabledBackgroundColor">#4DF9F9F9</Color>
    <Color x:Key="InstallerTheme.Light.ControlBorderColor">#29000000</Color>
    <Color x:Key="InstallerTheme.Light.ControlStrongBorderColor">#72000000</Color>
    <Color x:Key="InstallerTheme.Light.ControlDisabledBorderColor">#0F000000</Color>
    <Color x:Key="InstallerTheme.Light.ProgressTrackColor">#FFE1E1E1</Color>
    <Color x:Key="InstallerTheme.Light.TextOnAccentColor">#FFFFFFFF</Color>
    <Color x:Key="InstallerTheme.Light.CautionBackgroundColor">#FFFFF4CE</Color>
    <Color x:Key="InstallerTheme.Light.CautionBorderColor">#FF9D5D00</Color>
    <!-- The success and critical status colours of Windows 11 controls, like the caution colour above -->
    <Color x:Key="InstallerTheme.Light.SuccessTextColor">#FF0F7B0F</Color>
    <Color x:Key="InstallerTheme.Light.CriticalTextColor">#FFC42B1C</Color>

    <!-- Dark palette -->
    <Color x:Key="InstallerTheme.Dark.WindowBackgroundColor">#FF202020</Color>
    <Color x:Key="InstallerTheme.Dark.PrimaryTextColor">#FFFFFFFF</Color>
    <Color x:Key="InstallerTheme.Dark.SecondaryTextColor">#C5FFFFFF</Color>
    <Color x:Key="InstallerTheme.Dark.DisabledTextColor">#5DFFFFFF</Color>
    <Color x:Key="InstallerTheme.Dark.ControlBackgroundColor">#0FFFFFFF</Color>
    <Color x:Key="InstallerTheme.Dark.ControlHoverBackgroundColor">#15FFFFFF</Color>
    <Color x:Key="InstallerTheme.Dark.ControlPressedBackgroundColor">#08FFFFFF</Color>
    <Color x:Key="InstallerTheme.Dark.ControlDisabledBackgroundColor">#0BFFFFFF</Color>
    <Color x:Key="InstallerTheme.Dark.ControlBorderColor">#18FFFFFF</Color>
    <Color x:Key="InstallerTheme.Dark.ControlStrongBorderColor">#99FFFFFF</Color>
    <Color x:Key="InstallerTheme.Dark.ControlDisabledBorderColor">#12FFFFFF</Color>
    <Color x:Key="InstallerTheme.Dark.ProgressTrackColor">#FF393939</Color>
    <Color x:Key="InstallerTheme.Dark.TextOnAccentColor">#FF000000</Color>
    <Color x:Key="InstallerTheme.Dark.CautionBackgroundColor">#FF433519</Color>
    <Color x:Key="InstallerTheme.Dark.CautionBorderColor">#FFFCE100</Color>
    <Color x:Key="InstallerTheme.Dark.SuccessTextColor">#FF6CCB5F</Color>
    <Color x:Key="InstallerTheme.Dark.CriticalTextColor">#FFFF99A4</Color>

    <!-- Window. The installer window is a derived type, so WPF never applies an implicit Window style to it
         and the constructor assigns this one by key. -->
    <Style x:Key="InstallerTheme.WindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource InstallerTheme.WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource InstallerTheme.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource InstallerTheme.BodyFontSize}" />
        <Setter Property="Width" Value="{DynamicResource InstallerTheme.WindowWidth}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <!-- The whole window becomes client area and the template draws the title bar. Dragging, the system
             menu and Alt+F4 still come from Windows; only the parts marked hit-test visible take clicks. -->
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="{StaticResource InstallerTheme.CaptionHeight}"
                              GlassFrameThickness="{StaticResource InstallerTheme.CaptionGlassFrameThickness}"
                              ResizeBorderThickness="0"
                              CornerRadius="0"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Height="{DynamicResource InstallerTheme.CaptionHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- The window swaps in the frame drawn nearest this size on the current monitor -->
                                <Image x:Name="PART_CaptionIcon"
                                       Source="{TemplateBinding Icon}"
                                       Width="{DynamicResource InstallerTheme.CaptionIconSize}"
                                       Height="{DynamicResource InstallerTheme.CaptionIconSize}"
                                       Margin="{DynamicResource InstallerTheme.CaptionIconMargin}"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       WindowChrome.IsHitTestVisibleInChrome="True" />
                                <TextBlock x:Name="CaptionTitle"
                                           Grid.Column="1"
                                           Text="{TemplateBinding Title}"
                                           FontSize="{DynamicResource InstallerTheme.CaptionFontSize}"
                                           Foreground="{DynamicResource InstallerTheme.PrimaryTextBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <Button x:Name="PART_CloseButton"
                                        Grid.Column="2"
                                        Style="{DynamicResource InstallerTheme.CaptionCloseButtonStyle}"
                                        WindowChrome.IsHitTestVisibleInChrome="True" />
                            </Grid>
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter />
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Windows dims the title and the close glyph of a window that is not in front -->
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="CaptionTitle" Property="Foreground"
                                    Value="{DynamicResource InstallerTheme.DisabledTextBrush}" />
                            <Setter TargetName="PART_CloseButton" Property="Foreground"
                                    Value="{DynamicResource InstallerTheme.DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The title bar's close button. It takes no keyboard focus, like the buttons Windows draws. The surface
         must stay painted, even transparent, or only the glyph's own pixels would take the click. -->
    <Style x:Key="InstallerTheme.CaptionCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource InstallerTheme.CaptionButtonWidth}" />
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.PrimaryTextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CloseSurface" Background="Transparent">
                        <TextBlock x:Name="CloseGlyph"
                                   Text="{DynamicResource InstallerTheme.CloseGlyph}"
                                   FontFamily="{DynamicResource InstallerTheme.CaptionGlyphFontFamily}"
                                   FontSize="{DynamicResource InstallerTheme.CaptionGlyphFontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CloseSurface" Property="Background"
                                    Value="{DynamicResource InstallerTheme.CloseHoverBackgroundBrush}" />
                            <Setter TargetName="CloseGlyph" Property="Foreground"
                                    Value="{DynamicResource InstallerTheme.CloseActiveGlyphBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CloseSurface" Property="Background"
                                    Value="{DynamicResource InstallerTheme.ClosePressedBackgroundBrush}" />
                            <Setter TargetName="CloseGlyph" Property="Foreground"
                                    Value="{DynamicResource InstallerTheme.CloseActiveGlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text. Only wrapping is set implicitly: a Foreground or FontSize here would also land on the text
         block a ContentPresenter builds for a button's caption and would beat the button's own values. -->
    <Style TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="InstallerTheme.TitleTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="{DynamicResource InstallerTheme.TitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.PrimaryTextBrush}" />
    </Style>

    <Style x:Key="InstallerTheme.SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.PrimaryTextBrush}" />
    </Style>

    <Style x:Key="InstallerTheme.SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="{DynamicResource InstallerTheme.SecondaryFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.SecondaryTextBrush}" />
    </Style>

    <!-- Application install states. The window swaps between these as a run moves an application along.
         Waiting and Not installed keep the base style's secondary colour.
         Installing takes the primary text colour rather than the accent, which a grey accent would dim below the waiting rows. -->
    <Style x:Key="InstallerTheme.ApplicationStateTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="FontSize" Value="{DynamicResource InstallerTheme.SecondaryFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.SecondaryTextBrush}" />
        <Setter Property="Margin" Value="{DynamicResource InstallerTheme.ApplicationStateMargin}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="InstallerTheme.ApplicationStateInstallingTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource InstallerTheme.ApplicationStateTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.PrimaryTextBrush}" />
    </Style>

    <Style x:Key="InstallerTheme.ApplicationStateInstalledTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource InstallerTheme.ApplicationStateTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.SuccessTextBrush}" />
    </Style>

    <Style x:Key="InstallerTheme.ApplicationStateFailedTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource InstallerTheme.ApplicationStateTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.CriticalTextBrush}" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="InstallerTheme.ButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource InstallerTheme.ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InstallerTheme.ControlBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.PrimaryTextBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource InstallerTheme.ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InstallerTheme.ButtonPadding}" />
        <Setter Property="MinWidth" Value="{DynamicResource InstallerTheme.ButtonMinWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource InstallerTheme.ButtonMinHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource InstallerTheme.ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonSurface" Property="Background"
                                    Value="{DynamicResource InstallerTheme.ControlHoverBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonSurface" Property="Background"
                                    Value="{DynamicResource InstallerTheme.ControlPressedBackgroundBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource InstallerTheme.SecondaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonSurface" Property="BorderBrush"
                                    Value="{DynamicResource InstallerTheme.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonSurface" Property="Background"
                                    Value="{DynamicResource InstallerTheme.ControlDisabledBackgroundBrush}" />
                            <Setter TargetName="ButtonSurface" Property="BorderBrush"
                                    Value="{DynamicResource InstallerTheme.ControlDisabledBorderBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource InstallerTheme.DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource InstallerTheme.ButtonStyle}" />

    <!-- The default button. It carries its own template because its hover and pressed states shade the
         accent colour rather than the neutral control fill. -->
    <Style x:Key="InstallerTheme.AccentButtonStyle" TargetType="Button"
           BasedOn="{StaticResource InstallerTheme.ButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource InstallerTheme.AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InstallerTheme.AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.TextOnAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="AccentSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource InstallerTheme.ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="AccentSurface" Property="Background"
                                    Value="{DynamicResource InstallerTheme.AccentHoverBrush}" />
                            <Setter TargetName="AccentSurface" Property="BorderBrush"
                                    Value="{DynamicResource InstallerTheme.AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="AccentSurface" Property="Background"
                                    Value="{DynamicResource InstallerTheme.AccentPressedBrush}" />
                            <Setter TargetName="AccentSurface" Property="BorderBrush"
                                    Value="{DynamicResource InstallerTheme.AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="AccentSurface" Property="Background"
                                    Value="{DynamicResource InstallerTheme.ControlDisabledBackgroundBrush}" />
                            <Setter TargetName="AccentSurface" Property="BorderBrush"
                                    Value="{DynamicResource InstallerTheme.ControlDisabledBorderBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource InstallerTheme.DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Links in the Windhawk notice. Buttons rather than Hyperlink runs so the click handler stays in code. -->
    <Style x:Key="InstallerTheme.HyperlinkButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.AccentBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource InstallerTheme.LinkPadding}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="LinkText"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LinkText" Property="Foreground"
                                    Value="{DynamicResource InstallerTheme.AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="LinkText" Property="Foreground"
                                    Value="{DynamicResource InstallerTheme.DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check box -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InstallerTheme.ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InstallerTheme.ControlStrongBorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CheckBoxSurface"
                                Grid.Column="0"
                                Width="{DynamicResource InstallerTheme.SelectionGlyphSize}"
                                Height="{DynamicResource InstallerTheme.SelectionGlyphSize}"
                                Margin="{DynamicResource InstallerTheme.SelectionGlyphMargin}"
                                VerticalAlignment="Top"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{DynamicResource InstallerTheme.SelectionGlyphBorderThickness}"
                                CornerRadius="{DynamicResource InstallerTheme.CheckBoxCornerRadius}">
                            <Path x:Name="CheckGlyph"
                                  Data="M 4,10 L 8,14 L 16,5.5"
                                  Stroke="{DynamicResource InstallerTheme.TextOnAccentBrush}"
                                  StrokeThickness="{DynamicResource InstallerTheme.CheckGlyphThickness}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBoxSurface" Property="Background"
                                    Value="{DynamicResource InstallerTheme.AccentBrush}" />
                            <Setter TargetName="CheckBoxSurface" Property="BorderBrush"
                                    Value="{DynamicResource InstallerTheme.AccentBrush}" />
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBoxSurface" Property="BorderBrush"
                                    Value="{DynamicResource InstallerTheme.AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CheckBoxSurface" Property="BorderBrush"
                                    Value="{DynamicResource InstallerTheme.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckBoxSurface" Property="Background"
                                    Value="{DynamicResource InstallerTheme.ControlDisabledBackgroundBrush}" />
                            <Setter TargetName="CheckBoxSurface" Property="BorderBrush"
                                    Value="{DynamicResource InstallerTheme.ControlDisabledBorderBrush}" />
                            <Setter TargetName="CheckGlyph" Property="Stroke"
                                    Value="{DynamicResource InstallerTheme.DisabledTextBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource InstallerTheme.DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio button. The glyph is top aligned because the installation type buttons carry a title and a
         description, and a centred glyph would float between the two lines. -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InstallerTheme.ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InstallerTheme.ControlStrongBorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0"
                              Width="{DynamicResource InstallerTheme.SelectionGlyphSize}"
                              Height="{DynamicResource InstallerTheme.SelectionGlyphSize}"
                              Margin="{DynamicResource InstallerTheme.SelectionGlyphMargin}"
                              VerticalAlignment="Top">
                            <Ellipse x:Name="RadioSurface"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{DynamicResource InstallerTheme.SelectionGlyphStrokeThickness}" />
                            <Ellipse x:Name="RadioDot"
                                     Width="{DynamicResource InstallerTheme.RadioDotSize}"
                                     Height="{DynamicResource InstallerTheme.RadioDotSize}"
                                     Fill="{DynamicResource InstallerTheme.TextOnAccentBrush}"
                                     Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RadioSurface" Property="Fill"
                                    Value="{DynamicResource InstallerTheme.AccentBrush}" />
                            <Setter TargetName="RadioSurface" Property="Stroke"
                                    Value="{DynamicResource InstallerTheme.AccentBrush}" />
                            <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RadioSurface" Property="Stroke"
                                    Value="{DynamicResource InstallerTheme.AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RadioSurface" Property="Stroke"
                                    Value="{DynamicResource InstallerTheme.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RadioSurface" Property="Fill"
                                    Value="{DynamicResource InstallerTheme.ControlDisabledBackgroundBrush}" />
                            <Setter TargetName="RadioSurface" Property="Stroke"
                                    Value="{DynamicResource InstallerTheme.ControlDisabledBorderBrush}" />
                            <Setter TargetName="RadioDot" Property="Fill"
                                    Value="{DynamicResource InstallerTheme.DisabledTextBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource InstallerTheme.DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text box, with the accent underline Windows draws while the caret is in the field -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource InstallerTheme.ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InstallerTheme.ControlBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.PrimaryTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InstallerTheme.PrimaryTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource InstallerTheme.AccentBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource InstallerTheme.ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource InstallerTheme.TextBoxPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource InstallerTheme.TextBoxMinHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBoxSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource InstallerTheme.ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                            <Border x:Name="FocusUnderline"
                                    Height="{DynamicResource InstallerTheme.FocusUnderlineHeight}"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource InstallerTheme.AccentBrush}"
                                    CornerRadius="{DynamicResource InstallerTheme.ControlCornerRadius}"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusUnderline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="TextBoxSurface" Property="Background"
                                    Value="{DynamicResource InstallerTheme.ControlDisabledBackgroundBrush}" />
                            <Setter TargetName="FocusUnderline" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource InstallerTheme.SecondaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TextBoxSurface" Property="Background"
                                    Value="{DynamicResource InstallerTheme.ControlDisabledBackgroundBrush}" />
                            <Setter TargetName="TextBoxSurface" Property="BorderBrush"
                                    Value="{DynamicResource InstallerTheme.ControlDisabledBorderBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource InstallerTheme.DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Progress bar -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource InstallerTheme.ProgressTrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InstallerTheme.AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="{DynamicResource InstallerTheme.ProgressBarHeight}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource InstallerTheme.ProgressBarCornerRadius}" />
                        <Border x:Name="PART_Track" Background="Transparent" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{DynamicResource InstallerTheme.ProgressBarCornerRadius}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
