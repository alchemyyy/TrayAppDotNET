<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The .NET Framework is part of Windows, so the installer ships as one small managed executable
         instead of carrying a runtime and a renderer. WPF draws through the in-box compositor. -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>TrayAppDotNETInstaller</RootNamespace>
    <!-- One factory binary is built per release and then stamped into Installer_<Name>.exe files. Pack
         URIs embed this name, so it must never be overridden on the command line. -->
    <AssemblyName>TrayAppDotNETInstaller</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <!-- The SDK enables the .NET code analyzers by default only for .NET 5 and newer; enable them here so the
         repository .editorconfig rules apply to the installer as they do to the apps. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Nullable>enable</Nullable>
    <!-- The SDK only supplies implicit usings for .NET 6 and newer, so GlobalUsings.cs supplies the set. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>TrayAppDotNETInstaller.Program</StartupObject>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)\..\bin\$(Configuration)\</OutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <!-- Generates TrayAppDotNETCommon.Contracts.TrayAppDotNETAppCatalog (the installer cannot reference Common). The
         shared app targets (legal files, stamping) apply to app projects only, so the factory never packages its own
         LICENSE/NOTICE/.notices (the payload zips carry them) and never stamps itself. -->
    <TrayAppDotNETEmbedAppCatalog>true</TrayAppDotNETEmbedAppCatalog>
    <!-- Without this the SDK writes a TrayAppDotNETInstaller.exe.config beside the executable, which the
         app does not need and which would stop the output from being a single file. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <ApplicationIcon>$(MSBuildProjectDirectory)\..\app.ico</ApplicationIcon>
    <!-- Manifest resource prefix read by the runtime; keep in sync with the C# constant. -->
    <TrayAppDotNETInstallerIconResourcePrefix>TrayAppDotNETInstaller.Icons.</TrayAppDotNETInstallerIconResourcePrefix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'Prerelease'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- Supplies the 4.8 reference assemblies so the build does not depend on a targeting pack install. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <InternalsVisibleTo Include="TrayAppDotNETInstaller.Tests" />
  </ItemGroup>

  <!-- Generate the strongly typed resource API under obj so it always matches the RESX.
       Exclude source-tree custom-tool output to prevent duplicate classes. -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>C#</StronglyTypedLanguage>
      <StronglyTypedNamespace>$(RootNamespace).Localization</StronglyTypedNamespace>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
    <Compile Remove="Localization\Strings.Designer.cs" />
  </ItemGroup>

  <!-- The installer must not reference TrayAppDotNETCommon, so the contracts it shares with the apps (command
       line, folder names, the progress wire format, the shared native DLL list), the detached cleanup and the
       elevation policy are compiled in as linked source. These files stay .NET Framework 4.8 compatible. -->
  <ItemGroup>
    <Compile Include="..\..\TrayAppDotNETCommon\src\Contracts\*.cs" Link="Linked\Contracts\%(Filename)%(Extension)" />
    <Compile Include="..\..\TrayAppDotNETCommon\src\Utils\DetachedCleanup.cs" Link="Linked\DetachedCleanup.cs" />
    <Compile Include="..\..\TrayAppDotNETCommon\src\Utils\ElevationPolicy.cs" Link="Linked\ElevationPolicy.cs" />
  </ItemGroup>

  <!-- Every catalog app's icon plus the suite icon travels in the factory. A stamped installer picks its window icon
       from these by application name, so only the shell icon needs resource surgery. Each icon is a few kilobytes,
       which is negligible next to the payload. -->
  <Target Name="EmbedTrayAppDotNETInstallerIcons" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <TrayAppDotNETInstallerIcon Include="$(MSBuildProjectDirectory)\..\app.ico" IconName="TrayAppDotNET" />
      <TrayAppDotNETInstallerIcon Include="$(TrayAppDotNETRoot)%(TrayAppDotNETApp.Identity)\app.ico" IconName="%(TrayAppDotNETApp.Identity)" />
    </ItemGroup>
    <Error Condition="!Exists('%(TrayAppDotNETInstallerIcon.FullPath)')"
           Text="Installer icon not found: %(TrayAppDotNETInstallerIcon.FullPath). Run tools/AppIconGenerator first." />
    <ItemGroup>
      <EmbeddedResource Include="@(TrayAppDotNETInstallerIcon)"
                        LogicalName="$(TrayAppDotNETInstallerIconResourcePrefix)%(TrayAppDotNETInstallerIcon.IconName).ico"
                        Link="Icons\%(TrayAppDotNETInstallerIcon.IconName).ico"
                        WithCulture="false" />
    </ItemGroup>
  </Target>

  <!-- The icons above are added during the build, which Visual Studio's fast up-to-date check never evaluates. Listing
       them here makes a changed app or suite icon rebuild the factory. -->
  <ItemGroup>
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)\..\app.ico" />
    <UpToDateCheckInput Include="@(TrayAppDotNETApp->'$(TrayAppDotNETRoot)%(Identity)\app.ico')" />
  </ItemGroup>
</Project>
