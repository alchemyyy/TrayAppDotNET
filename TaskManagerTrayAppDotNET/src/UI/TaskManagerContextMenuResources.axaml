<ResourceDictionary
    x:Class="TaskManagerTrayAppDotNET.UI.TaskManagerContextMenuResources"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Task Manager content context menus; the tray menu does not consume these values -->
  <sys:Double x:Key="TaskManagerContextMenu.FontSize">13</sys:Double>
  <!-- OpenType weight: 400 normal, 600 semibold, 700 bold -->
  <sys:Int32 x:Key="TaskManagerContextMenu.FontWeight">400</sys:Int32>
  <sys:Double x:Key="TaskManagerContextMenu.ItemHeight">24</sys:Double>

  <!-- Process-search column autocomplete -->
  <sys:Double x:Key="TaskManagerContextMenu.AutocompleteWidth">252</sys:Double>
  <sys:Double x:Key="TaskManagerContextMenu.AutocompleteFontSize">12</sys:Double>
  <sys:Double x:Key="TaskManagerContextMenu.AutocompleteItemHeight">22</sys:Double>
  <sys:Double x:Key="TaskManagerContextMenu.AutocompleteVerticalOffset">3</sys:Double>
  <Thickness x:Key="TaskManagerContextMenu.AutocompletePadding">3</Thickness>
  <Thickness x:Key="TaskManagerContextMenu.AutocompleteItemPadding">8,0</Thickness>
  <Thickness x:Key="TaskManagerContextMenu.AutocompleteBorderThickness">1</Thickness>
  <CornerRadius x:Key="TaskManagerContextMenu.AutocompleteCornerRadius">5</CornerRadius>
  <CornerRadius x:Key="TaskManagerContextMenu.AutocompleteItemCornerRadius">3</CornerRadius>

  <!-- Process saved searches -->
  <sys:Double x:Key="TaskManagerContextMenu.SavedSearchMaximumHeight">320</sys:Double>
  <sys:Double x:Key="TaskManagerContextMenu.SavedSearchItemHeight">32</sys:Double>
  <sys:Double x:Key="TaskManagerContextMenu.SavedSearchButtonSize">24</sys:Double>
  <sys:Double x:Key="TaskManagerContextMenu.SavedSearchButtonGlyphFontSize">12</sys:Double>
  <sys:Double x:Key="TaskManagerContextMenu.SavedSearchDeleteButtonFontSize">20</sys:Double>
  <sys:Double x:Key="TaskManagerContextMenu.SavedSearchNameMaximumWidth">145</sys:Double>
  <sys:Double x:Key="TaskManagerContextMenu.SavedSearchColumnSpacing">5</sys:Double>
  <sys:Double x:Key="TaskManagerContextMenu.SavedSearchLeadingButtonTextSpacing">1</sys:Double>
  <sys:Double x:Key="TaskManagerContextMenu.SavedSearchQueryOpacity">0.68</sys:Double>
  <Thickness x:Key="TaskManagerContextMenu.SavedSearchItemPadding">3,0,4,0</Thickness>
  <Thickness x:Key="TaskManagerContextMenu.SavedSearchButtonPadding">0</Thickness>
</ResourceDictionary>
