<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared app settings, references, resources and targets come from TrayAppDotNET.Parent.props and
       TrayAppDotNET.Parent.targets; this file holds only what is particular to the app. -->
  <PropertyGroup>
    <!-- The process table and performance history need more heap than the shared default. -->
    <TrayAppDotNETGCHeapHardLimitBytes>209715200</TrayAppDotNETGCHeapHardLimitBytes>
    <!-- Standalone dictionaries use the runtime loader throughout Debug, independently of HotAvalonia injection. -->
    <TrayAppDotNETCopyXamlLoaderInDebug>true</TrayAppDotNETCopyXamlLoaderInDebug>
    <NativeKillHelperFileName>TaskManagerTrayAppDotNET.KillHelper.exe</NativeKillHelperFileName>
    <NativeKillHelperSourceDirectory>$(MSBuildProjectDirectory)\..\native\KillHelper</NativeKillHelperSourceDirectory>
    <NativeKillHelperProject>$(NativeKillHelperSourceDirectory)\TaskManagerTrayAppDotNET.KillHelper.vcxproj</NativeKillHelperProject>
    <NativeKillHelperBuildScript>$(NativeKillHelperSourceDirectory)\BuildKillHelper.ps1</NativeKillHelperBuildScript>
    <NativeKillHelperIntermediateDirectory>$(MSBuildProjectDirectory)\..\obj\$(Platform)\$(Configuration)</NativeKillHelperIntermediateDirectory>
    <NativeKillHelperBuildDirectory>$(NativeKillHelperIntermediateDirectory)\kill-helper</NativeKillHelperBuildDirectory>
    <NativeKillHelperBuildDirectory Condition="'$(RuntimeIdentifier)' != ''">$(NativeKillHelperIntermediateDirectory)\$(RuntimeIdentifier)\kill-helper</NativeKillHelperBuildDirectory>
    <NativeKillHelperExecutable>$(NativeKillHelperBuildDirectory)\out\$(NativeKillHelperFileName)</NativeKillHelperExecutable>
    <NativeKillHelperLibraryFileName>TaskManagerTrayAppDotNET.KillHelper.NativeAOT.lib</NativeKillHelperLibraryFileName>
    <NativeKillHelperLibrary>$(NativeKillHelperBuildDirectory)\out\$(NativeKillHelperLibraryFileName)</NativeKillHelperLibrary>
    <NativeKillHelperConfiguration Condition="'$(Configuration)' == 'Debug'">Debug</NativeKillHelperConfiguration>
    <NativeKillHelperConfiguration Condition="'$(NativeKillHelperConfiguration)' == ''">Release</NativeKillHelperConfiguration>
    <TrayAppDotNETAdditionalUnlockProcessNames>TaskManagerTrayAppDotNET.KillHelper</TrayAppDotNETAdditionalUnlockProcessNames>
  </PropertyGroup>

  <!-- Native AOT links the kill helper into the app (custom native entry point); see the native helper targets below. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <CustomNativeMain>true</CustomNativeMain>
    <ControlFlowGuard>Guard</ControlFlowGuard>
    <IlcDefaultStackSize>1572864,131072</IlcDefaultStackSize>
    <DefineConstants>$(DefineConstants);TASK_MANAGER_NATIVE_AOT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <NativeKillHelperBuildKind Condition="'$(CustomNativeMain)' == 'true'">NativeAOT</NativeKillHelperBuildKind>
    <NativeKillHelperBuildKind Condition="'$(NativeKillHelperBuildKind)' == ''">Sidecar</NativeKillHelperBuildKind>
    <NativeKillHelperBuildOutput Condition="'$(CustomNativeMain)' == 'true'">$(NativeKillHelperLibrary)</NativeKillHelperBuildOutput>
    <NativeKillHelperBuildOutput Condition="'$(NativeKillHelperBuildOutput)' == ''">$(NativeKillHelperExecutable)</NativeKillHelperBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="TrayAppDotNETCommon.TADNLog" Alias="TADNLog" />
    <Using Include="TrayAppDotNETCommon" />
    <Using Include="TrayAppDotNETCommon.Interop" />
    <Using Include="TrayAppDotNETCommon.Localization" />
    <Using Include="TrayAppDotNETCommon.Models" />
    <Using Include="TrayAppDotNETCommon.Services" />
    <Using Include="TrayAppDotNETCommon.Services.Install" />
    <Using Include="TrayAppDotNETCommon.UI" />
    <Using Include="TrayAppDotNETCommon.UI.ContextMenus" />
    <Using Include="TrayAppDotNETCommon.UI.Controls" />
    <Using Include="TrayAppDotNETCommon.UI.Tray" />
    <Using Include="TrayAppDotNETCommon.Utils" />
    <Using Include="TaskManagerTrayAppDotNET.Models" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TaskManagerTrayAppDotNET.Tests" />
    <_NativeKillHelperSource Include="$(NativeKillHelperSourceDirectory)\**\*" />
    <Content Include="$(NativeKillHelperExecutable)"
             Condition="'$(CustomNativeMain)' != 'true'"
             Link="$(NativeKillHelperFileName)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
    <NativeLibrary Include="$(NativeKillHelperLibrary)"
                   Condition="'$(CustomNativeMain)' == 'true'" />
    <!-- A non-AOT build leaves the sidecar helper in the output folder; the Native AOT app embeds it. -->
    <TrayAppDotNETPublishOutputStaleFile Include="$(NativeKillHelperFileName)" />
  </ItemGroup>

  <Target Name="BuildNativeKillHelper"
          BeforeTargets="PrepareForBuild"
          Inputs="@(_NativeKillHelperSource)"
          Outputs="$(NativeKillHelperBuildOutput)">
    <MakeDir Directories="$(NativeKillHelperBuildDirectory)" />
    <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(NativeKillHelperBuildScript)&quot; -ProjectPath &quot;$(NativeKillHelperProject)&quot; -OutputDirectory &quot;$(NativeKillHelperBuildDirectory)\out&quot; -Configuration &quot;$(NativeKillHelperConfiguration)&quot; -BuildKind &quot;$(NativeKillHelperBuildKind)&quot;" />
    <Error Condition="!Exists('$(NativeKillHelperBuildOutput)')"
           Text="Native kill helper output was not produced at $(NativeKillHelperBuildOutput)." />
  </Target>

  <Target Name="RemoveNativeKillHelperSidecarFromAOTOutput"
          BeforeTargets="PrepareForBuild;PrepareForPublish"
          Condition="'$(CustomNativeMain)' == 'true'">
    <ItemGroup>
      <_NativeKillHelperStaleSidecar Include="$(TargetDir)$(NativeKillHelperFileName)" />
      <_NativeKillHelperStaleSidecar Include="$(PublishDir)$(NativeKillHelperFileName)"
                                     Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(_NativeKillHelperStaleSidecar)" />
  </Target>

  <Target Name="CleanNativeKillHelper" AfterTargets="Clean">
    <RemoveDir Directories="$(NativeKillHelperIntermediateDirectory)\kill-helper;$(NativeKillHelperIntermediateDirectory)\win-x64\kill-helper"
               Condition="Exists('$(NativeKillHelperIntermediateDirectory)\kill-helper') or Exists('$(NativeKillHelperIntermediateDirectory)\win-x64\kill-helper')" />
  </Target>

  <!-- Make Visual Studio reject an incomplete shared Debug output as up to date. -->
  <Target Name="CollectHotAvaloniaRuntimeAssembliesForUpToDateCheck"
          BeforeTargets="CollectUpToDateCheckBuiltDesignTime"
          Condition="'$(Configuration)' == 'Debug' and '$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <_HotAvaloniaCorePath>$(NuGetPackageRoot)hotavalonia.core\$(TrayAppDotNETHotAvaloniaVersion)\lib\netstandard2.1\HotAvalonia.Core.dll</_HotAvaloniaCorePath>
      <_HotAvaloniaXamlLoaderPath>$(NuGetPackageRoot)avalonia.markup.xaml.loader\$(TrayAppDotNETAvaloniaVersion)\lib\net10.0\Avalonia.Markup.Xaml.Loader.dll</_HotAvaloniaXamlLoaderPath>
    </PropertyGroup>
    <ItemGroup>
      <UpToDateCheckBuilt Include="$(TargetDir)HotAvalonia.Core.dll"
                          Original="$(_HotAvaloniaCorePath)" />
      <UpToDateCheckBuilt Include="$(TargetDir)Avalonia.Markup.Xaml.Loader.dll"
                          Original="$(_HotAvaloniaXamlLoaderPath)" />
    </ItemGroup>
  </Target>
</Project>
