<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>TaskManagerTrayAppDotNET</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>TaskManagerTrayAppDotNET.Program</StartupObject>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)\..\bin\$(Configuration)\</OutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsAotCompatible>true</IsAotCompatible>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == ''">win-x64</RuntimeIdentifiers>
    <PublishAot Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'ReleaseWithDebugging'">true</PublishAot>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
    <HotAvaloniaPackageVersion>3.1.1</HotAvaloniaPackageVersion>
    <HotAvaloniaAutoEnable>false</HotAvaloniaAutoEnable>
    <HotAvaloniaMode>Balanced</HotAvaloniaMode>
    <ApplicationIcon Condition="Exists('$(MSBuildProjectDirectory)\..\app.ico')">..\app.ico</ApplicationIcon>
    <_DefaultTrayAppDotNETCommonRoot>$(MSBuildProjectDirectory)\..\..\TrayAppDotNETCommon</_DefaultTrayAppDotNETCommonRoot>
    <_DefaultTrayAppDotNETCommonProject>$(_DefaultTrayAppDotNETCommonRoot)\src\TrayAppDotNETCommon.csproj</_DefaultTrayAppDotNETCommonProject>
    <TrayAppDotNETCommonRoot Condition="'$(TrayAppDotNETCommonRoot)' == ''">$(_DefaultTrayAppDotNETCommonRoot)</TrayAppDotNETCommonRoot>
    <TrayAppDotNETCommonProject Condition="'$(TrayAppDotNETCommonProject)' == ''">$(TrayAppDotNETCommonRoot)\src\TrayAppDotNETCommon.csproj</TrayAppDotNETCommonProject>
    <NativeKillHelperFileName>TaskManagerTrayAppDotNET.KillHelper.exe</NativeKillHelperFileName>
    <NativeKillHelperSourceDirectory>$(MSBuildProjectDirectory)\..\native\KillHelper</NativeKillHelperSourceDirectory>
    <NativeKillHelperIntermediateDirectory>$(MSBuildProjectDirectory)\..\obj\$(Platform)\$(Configuration)</NativeKillHelperIntermediateDirectory>
    <NativeKillHelperBuildDirectory>$(NativeKillHelperIntermediateDirectory)\kill-helper</NativeKillHelperBuildDirectory>
    <NativeKillHelperBuildDirectory Condition="'$(RuntimeIdentifier)' != ''">$(NativeKillHelperIntermediateDirectory)\$(RuntimeIdentifier)\kill-helper</NativeKillHelperBuildDirectory>
    <NativeKillHelperExecutable>$(NativeKillHelperBuildDirectory)\out\$(NativeKillHelperFileName)</NativeKillHelperExecutable>
    <NativeKillHelperLibraryFileName>TaskManagerTrayAppDotNET.KillHelper.NativeAOT.lib</NativeKillHelperLibraryFileName>
    <NativeKillHelperLibrary>$(NativeKillHelperBuildDirectory)\out\$(NativeKillHelperLibraryFileName)</NativeKillHelperLibrary>
    <NativeKillHelperConfiguration Condition="'$(Configuration)' == 'Debug'">Debug</NativeKillHelperConfiguration>
    <NativeKillHelperConfiguration Condition="'$(NativeKillHelperConfiguration)' == ''">Release</NativeKillHelperConfiguration>
    <TrayAppDotNETAdditionalUnlockProcessNames>TaskManagerTrayAppDotNET.KillHelper</TrayAppDotNETAdditionalUnlockProcessNames>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <EnableGeneratedComInterfaceComImportInterop>true</EnableGeneratedComInterfaceComImportInterop>
    <OptimizationPreference>Speed</OptimizationPreference>
    <CustomNativeMain>true</CustomNativeMain>
    <ControlFlowGuard>Guard</ControlFlowGuard>
    <IlcDefaultStackSize>1572864,131072</IlcDefaultStackSize>
    <DefineConstants>$(DefineConstants);TASK_MANAGER_NATIVE_AOT</DefineConstants>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <NativeKillHelperBuildOutput Condition="'$(CustomNativeMain)' == 'true'">$(NativeKillHelperLibrary)</NativeKillHelperBuildOutput>
    <NativeKillHelperBuildOutput Condition="'$(NativeKillHelperBuildOutput)' == ''">$(NativeKillHelperExecutable)</NativeKillHelperBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="TrayAppDotNETCommon.TADNLog" Alias="TADNLog" />
    <Using Include="TrayAppDotNETCommon" />
    <Using Include="TrayAppDotNETCommon.Interop" />
    <Using Include="TrayAppDotNETCommon.Localization" />
    <Using Include="TrayAppDotNETCommon.Models" />
    <Using Include="TrayAppDotNETCommon.Services" />
    <Using Include="TrayAppDotNETCommon.Services.Install" />
    <Using Include="TrayAppDotNETCommon.UI" />
    <Using Include="TrayAppDotNETCommon.UI.ContextMenus" />
    <Using Include="TrayAppDotNETCommon.UI.Controls" />
    <Using Include="TrayAppDotNETCommon.UI.Tray" />
    <Using Include="TrayAppDotNETCommon.Utils" />
    <Using Include="TaskManagerTrayAppDotNET.Models" />
    <ProjectReference Include="$(TrayAppDotNETCommonProject)"
                      Targets="$(TrayAppDotNETSharedProjectReferenceTargets)"
                      GlobalPropertiesToRemove="OutputPath;OutDir;PublishDir" />
    <ProjectReference Include="..\..\TrayAppDotNETCommon\generators\XmlSourceGenerator\TrayAppDotNETCommon.XmlSourceGenerator.csproj"
                      Condition="'$(MSBuildIsRestoring)' != 'true' or '$(PublishAot)' != 'true'"
                      Targets="$(TrayAppDotNETSharedProjectReferenceTargets)"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;SelfContained;RuntimeIdentifier;RuntimeIdentifiers;PublishSingleFile;IncludeNativeLibrariesForSelfExtract;IncludeAllContentForSelfExtract;UseAppHost;OutputPath;OutDir;PublishDir"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\TrayAppDotNETCommon\generators\AxamlPropertyLinker\TrayAppDotNETCommon.AxamlPropertyLinker.csproj"
                      Condition="'$(MSBuildIsRestoring)' != 'true' or '$(PublishAot)' != 'true'"
                      Targets="$(TrayAppDotNETSharedProjectReferenceTargets)"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;SelfContained;RuntimeIdentifier;RuntimeIdentifiers;PublishSingleFile;IncludeNativeLibrariesForSelfExtract;IncludeAllContentForSelfExtract;UseAppHost;OutputPath;OutDir;PublishDir"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)" PrivateAssets="All" Publish="True"
                      Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="HotAvalonia" Version="$(HotAvaloniaPackageVersion)" PrivateAssets="All" Publish="True"
                      Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\app.ico" Link="Assets/app.ico" Condition="Exists('$(MSBuildProjectDirectory)\..\app.ico')" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="**\*.axaml" />
    <InternalsVisibleTo Include="TaskManagerTrayAppDotNET.Tests" />
    <_NativeKillHelperSource Include="$(NativeKillHelperSourceDirectory)\**\*" />
    <Content Include="$(NativeKillHelperExecutable)"
             Condition="'$(CustomNativeMain)' != 'true'"
             Link="$(NativeKillHelperFileName)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
    <NativeLibrary Include="$(NativeKillHelperLibrary)"
                   Condition="'$(CustomNativeMain)' == 'true'" />
  </ItemGroup>

  <Target Name="BuildNativeKillHelper"
          BeforeTargets="PrepareForBuild"
          Inputs="@(_NativeKillHelperSource)"
          Outputs="$(NativeKillHelperBuildOutput)">
    <MakeDir Directories="$(NativeKillHelperBuildDirectory)" />
    <Exec Command="cmake -S &quot;$(NativeKillHelperSourceDirectory)&quot; -B &quot;$(NativeKillHelperBuildDirectory)&quot; -A x64" />
    <Exec Condition="'$(CustomNativeMain)' == 'true'"
          Command="cmake --build &quot;$(NativeKillHelperBuildDirectory)&quot; --config $(NativeKillHelperConfiguration) --target TaskManagerTrayAppDotNETKillHelperNativeAOT" />
    <Exec Condition="'$(CustomNativeMain)' != 'true'"
          Command="cmake --build &quot;$(NativeKillHelperBuildDirectory)&quot; --config $(NativeKillHelperConfiguration) --target TaskManagerTrayAppDotNETKillHelper" />
    <Error Condition="!Exists('$(NativeKillHelperBuildOutput)')"
           Text="Native kill helper output was not produced at $(NativeKillHelperBuildOutput)." />
  </Target>

  <Target Name="RemoveNativeKillHelperSidecarFromAOTOutput"
          BeforeTargets="PrepareForBuild;PrepareForPublish"
          Condition="'$(CustomNativeMain)' == 'true'">
    <ItemGroup>
      <_NativeKillHelperStaleSidecar Include="$(TargetDir)$(NativeKillHelperFileName)" />
      <_NativeKillHelperStaleSidecar Include="$(PublishDir)$(NativeKillHelperFileName)"
                                     Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(_NativeKillHelperStaleSidecar)" />
  </Target>

  <Target Name="CleanNativeKillHelper" AfterTargets="Clean">
    <RemoveDir Directories="$(NativeKillHelperIntermediateDirectory)\kill-helper;$(NativeKillHelperIntermediateDirectory)\win-x64\kill-helper"
               Condition="Exists('$(NativeKillHelperIntermediateDirectory)\kill-helper') or Exists('$(NativeKillHelperIntermediateDirectory)\win-x64\kill-helper')" />
  </Target>

  <Target Name="CopyHotAvaloniaRuntimeAssemblies"
          AfterTargets="Build"
          Condition="'$(HotAvalonia)' == 'true' and '$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <_HotAvaloniaCorePath>$(NuGetPackageRoot)hotavalonia.core\$(HotAvaloniaPackageVersion)\lib\netstandard2.1\HotAvalonia.Core.dll</_HotAvaloniaCorePath>
      <_HotAvaloniaXamlLoaderPath>$(NuGetPackageRoot)avalonia.markup.xaml.loader\$(AvaloniaVersion)\lib\net10.0\Avalonia.Markup.Xaml.Loader.dll</_HotAvaloniaXamlLoaderPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(_HotAvaloniaCorePath)')"
           Text="HotAvalonia.Core.dll was not found at $(_HotAvaloniaCorePath)." />
    <Error Condition="!Exists('$(_HotAvaloniaXamlLoaderPath)')"
           Text="Avalonia.Markup.Xaml.Loader.dll was not found at $(_HotAvaloniaXamlLoaderPath)." />
    <ItemGroup>
      <_HotAvaloniaRuntimeAssembly Include="$(_HotAvaloniaCorePath)" />
      <_HotAvaloniaRuntimeAssembly Include="$(_HotAvaloniaXamlLoaderPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(_HotAvaloniaRuntimeAssembly)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Retries="$(CopyRetryCount)"
          RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)" />
  </Target>

  <Target Name="CopyRuntimeReferencesToAggregateManagedOutput"
          AfterTargets="Build"
          Condition="'$(TrayAppDotNETUseRootOutput)' == 'true' and ('$(Configuration)' == 'Debug' or '$(Configuration)' == 'Prerelease') and '$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <_AggregateManagedRuntimeReference Include="@(ReferenceCopyLocalPaths)"
                                         Condition="'%(ReferenceCopyLocalPaths.Extension)' != '.xml'" />
      <_AggregateManagedRuntimeReferenceWithDestination Include="@(_AggregateManagedRuntimeReference)"
                                                        Condition="'%(_AggregateManagedRuntimeReference.DestinationSubPath)' != ''" />
      <_AggregateManagedRuntimeReferenceWithDestination Include="@(_AggregateManagedRuntimeReference)"
                                                        Condition="'%(_AggregateManagedRuntimeReference.DestinationSubPath)' == ''">
        <DestinationSubPath>%(Filename)%(Extension)</DestinationSubPath>
      </_AggregateManagedRuntimeReferenceWithDestination>
    </ItemGroup>

    <Copy SourceFiles="@(_AggregateManagedRuntimeReferenceWithDestination)"
          DestinationFiles="@(_AggregateManagedRuntimeReferenceWithDestination->'$(TargetDir)%(DestinationSubPath)')"
          SkipUnchangedFiles="true"
          Retries="$(CopyRetryCount)"
          RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
          Condition="'@(_AggregateManagedRuntimeReferenceWithDestination)' != ''" />
  </Target>

  <Target Name="PublishAfterBuild" AfterTargets="Build"
          Condition="'$(SkipPublishAfterBuild)' != 'true' and '$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <_PublishOutputPath>$(IntermediateOutputPath)native-publish\</_PublishOutputPath>
    </PropertyGroup>
    <Message Importance="High" Text="Publishing Native AOT release..." />
    <RemoveDir Directories="$(_PublishOutputPath)" Condition="Exists('$(_PublishOutputPath)')" ContinueOnError="WarnAndContinue" />
    <MakeDir Directories="$(_PublishOutputPath)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -r win-x64 --no-restore -o &quot;$(_PublishOutputPath).&quot; -p:SkipPublishAfterBuild=true -p:TrayAppDotNETBuildSharedProjectReferences=false $(TrayAppDotNETPublishAggregateProperties) -p:SkipKillRunningInstance=$(SkipKillRunningInstance)" />
    <RemoveDir Directories="$(_PublishOutputPath)win-x64" Condition="Exists('$(_PublishOutputPath)win-x64')" ContinueOnError="WarnAndContinue" />
    <ItemGroup>
      <_TrayAppDotNETPublishedFile Include="$(_PublishOutputPath)**\*" Exclude="$(_PublishOutputPath)native\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TrayAppDotNETPublishedFile)"
          DestinationFiles="@(_TrayAppDotNETPublishedFile->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Retries="$(CopyRetryCount)"
          RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
          ContinueOnError="WarnAndContinue"
          Condition="'@(_TrayAppDotNETPublishedFile)' != ''" />
    <Delete Files="$(OutputPath)$(NativeKillHelperFileName)"
            Condition="Exists('$(OutputPath)$(NativeKillHelperFileName)')" />
    <Message Importance="High" Text="Published to $(OutputPath)" />
  </Target>
</Project>
