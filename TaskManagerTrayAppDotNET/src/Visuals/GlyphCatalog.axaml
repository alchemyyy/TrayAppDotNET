<ResourceDictionary
    x:Class="TaskManagerTrayAppDotNET.Visuals.GlyphCatalogResources"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:visuals="clr-namespace:TrayAppDotNETCommon.Visuals;assembly=TrayAppDotNETCommon">

    <!-- Application identity -->
    <visuals:GlyphDefinition x:Key="GlyphCatalog.PC1" Text="&#xE977;" Font="SegoeFluentIcons" />
    <visuals:GlyphDefinition x:Key="GlyphCatalog.TaskManagerApp" Text="&#xF120;" Font="SegoeFluentIcons" />
    <sys:Int32 x:Key="GlyphCatalog.AppIconDesignCanvasSize">1024</sys:Int32>
    <sys:Double x:Key="GlyphCatalog.AppIconOuterMarginFraction">0.055</sys:Double>
    <sys:Double x:Key="GlyphCatalog.TaskManagerAppScaleX">0.625</sys:Double>
    <sys:Double x:Key="GlyphCatalog.TaskManagerAppScaleY">0.6666666666666666</sys:Double>
    <sys:Double x:Key="GlyphCatalog.TaskManagerAppTranslateX">384</sys:Double>
    <sys:Double x:Key="GlyphCatalog.TaskManagerAppTranslateY">234.66666666666666</sys:Double>

    <!-- Task Manager commands -->
    <visuals:GlyphDefinition x:Key="GlyphCatalog.More" Text="&#xE712;" Font="SegoeFluentIcons" />
    <visuals:GlyphDefinition x:Key="GlyphCatalog.Save" Text="&#xE74E;" Font="SegoeFluentIcons" />
    <visuals:GlyphDefinition x:Key="GlyphCatalog.ChevronUpBig" Text="&#xE96D;" Font="SegoeFluentIconsThenMDL2Assets" TranslateY="1" />
    <visuals:GlyphDefinition x:Key="GlyphCatalog.ChevronDownBig" Text="&#xE96E;" Font="SegoeFluentIconsThenMDL2Assets" TranslateY="-1" />
    <visuals:GlyphDefinition x:Key="GlyphCatalog.CaretLeft" Text="&#xE96E;" Font="SegoeFluentIconsThenMDL2Assets" TranslateY="-1" />
    <visuals:GlyphDefinition x:Key="GlyphCatalog.CaretRight" Text="&#xE96D;" Font="SegoeFluentIconsThenMDL2Assets" TranslateY="1" />

    <!-- Task Manager navigation and state -->
    <visuals:GlyphDefinition x:Key="GlyphCatalog.Processes" Text="&#xECAA;" Font="SegoeFluentIconsThenMDL2Assets" />
    <visuals:GlyphDefinition x:Key="GlyphCatalog.Performance" Text="&#xE9D9;" Font="SegoeFluentIconsThenMDL2Assets" />
    <visuals:GlyphDefinition x:Key="GlyphCatalog.AppHistory" Text="&#xE81C;" Font="SegoeFluentIconsThenMDL2Assets" />
    <visuals:GlyphDefinition x:Key="GlyphCatalog.StartupApps" Text="&#xE768;" Font="SegoeFluentIconsThenMDL2Assets" TranslateY="-1" />
    <visuals:GlyphDefinition x:Key="GlyphCatalog.Users" Text="&#xE716;" Font="SegoeFluentIconsThenMDL2Assets" />
    <visuals:GlyphDefinition x:Key="GlyphCatalog.Services" Text="&#xEA86;" Font="SegoeFluentIconsThenMDL2Assets" TranslateY="-1" />
    <visuals:GlyphDefinition x:Key="GlyphCatalog.Selected" Text="&#xE73E;" Font="SegoeFluentIconsThenMDL2Assets" />
    <visuals:GlyphDefinition x:Key="GlyphCatalog.SortAscending" Text="&#xE96E;" Font="SegoeFluentIcons" />
    <visuals:GlyphDefinition x:Key="GlyphCatalog.SortDescending" Text="&#xE96D;" Font="SegoeFluentIcons" />
</ResourceDictionary>
