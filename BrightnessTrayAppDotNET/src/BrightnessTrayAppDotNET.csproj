<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>BrightnessTrayAppDotNET</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>BrightnessTrayAppDotNET.Program</StartupObject>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)\..\bin\$(Configuration)\</OutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsAotCompatible>true</IsAotCompatible>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == ''">win-x64</RuntimeIdentifiers>
    <PublishAot Condition="'$(Configuration)' == 'Release' or '$(Configuration)' == 'ReleaseWithDebugging'">true</PublishAot>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
    <HotAvaloniaPackageVersion>3.1.1</HotAvaloniaPackageVersion>
    <HotAvaloniaAutoEnable>false</HotAvaloniaAutoEnable>
    <HotAvaloniaMode>Balanced</HotAvaloniaMode>
    <ApplicationIcon Condition="Exists('$(MSBuildProjectDirectory)\..\app.ico')">..\app.ico</ApplicationIcon>
    <_DefaultTrayAppDotNETCommonRoot>$(MSBuildProjectDirectory)\..\..\TrayAppDotNETCommon</_DefaultTrayAppDotNETCommonRoot>
    <_DefaultTrayAppDotNETCommonProject>$(_DefaultTrayAppDotNETCommonRoot)\src\TrayAppDotNETCommon.csproj</_DefaultTrayAppDotNETCommonProject>
    <TrayAppDotNETCommonRoot Condition="'$(TrayAppDotNETCommonRoot)' == ''">$(_DefaultTrayAppDotNETCommonRoot)</TrayAppDotNETCommonRoot>
    <TrayAppDotNETCommonProject Condition="'$(TrayAppDotNETCommonProject)' == ''">$(TrayAppDotNETCommonRoot)\src\TrayAppDotNETCommon.csproj</TrayAppDotNETCommonProject>
    <NativeHelpersFileName>BrightnessTrayAppDotNET.NativeHelpers.exe</NativeHelpersFileName>
    <NativeHelpersSourceDirectory>$(MSBuildProjectDirectory)\..\native\NativeHelpers</NativeHelpersSourceDirectory>
    <NativeHelpersIntermediateDirectory>$(MSBuildProjectDirectory)\..\obj\native</NativeHelpersIntermediateDirectory>
    <NativeHelpersConfiguration Condition="'$(Configuration)' == 'Debug'">Debug</NativeHelpersConfiguration>
    <NativeHelpersConfiguration Condition="'$(NativeHelpersConfiguration)' == ''">Release</NativeHelpersConfiguration>
    <NativeHelpersBuildDirectory>$(NativeHelpersIntermediateDirectory)\$(NativeHelpersConfiguration)</NativeHelpersBuildDirectory>
    <NativeHelpersExecutable>$(NativeHelpersBuildDirectory)\out\$(NativeHelpersFileName)</NativeHelpersExecutable>
    <NativeHelpersLibraryFileName>BrightnessTrayAppDotNET.NativeHelpers.NativeAOT.lib</NativeHelpersLibraryFileName>
    <NativeHelpersLibrary>$(NativeHelpersBuildDirectory)\out\$(NativeHelpersLibraryFileName)</NativeHelpersLibrary>
    <TrayAppDotNETAdditionalUnlockProcessNames>BrightnessTrayAppDotNET.NativeHelpers</TrayAppDotNETAdditionalUnlockProcessNames>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <EnableGeneratedComInterfaceComImportInterop>true</EnableGeneratedComInterfaceComImportInterop>
    <OptimizationPreference>Speed</OptimizationPreference>
    <CustomNativeMain>true</CustomNativeMain>
    <ControlFlowGuard>Guard</ControlFlowGuard>
    <DefineConstants>$(DefineConstants);BRIGHTNESS_NATIVE_AOT</DefineConstants>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <NativeHelpersBuildOutput Condition="'$(CustomNativeMain)' == 'true'">$(NativeHelpersLibrary)</NativeHelpersBuildOutput>
    <NativeHelpersBuildOutput Condition="'$(NativeHelpersBuildOutput)' == ''">$(NativeHelpersExecutable)</NativeHelpersBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Visuals\map_fla-shop.com_ccby4.0.svg" />
    <None Remove="nul" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TrayAppDotNETCommon.TADNLog" Alias="TADNLog" />
    <Using Include="TrayAppDotNETCommon" />
    <Using Include="TrayAppDotNETCommon.Interop" />
    <Using Include="TrayAppDotNETCommon.UI.ContextMenus" />
    <Using Include="BrightnessTrayAppDotNET" />
    <Using Include="BrightnessTrayAppDotNET.Models" />
    <Using Include="BrightnessTrayAppDotNET.Services" />
    <Using Include="BrightnessTrayAppDotNET.Visuals" />
    <Using Include="BrightnessTrayAppDotNET.Models.ContextMenuPosition" Alias="ContextMenuPosition" />
    <ProjectReference Include="$(TrayAppDotNETCommonProject)"
                      Targets="$(TrayAppDotNETSharedProjectReferenceTargets)"
                      GlobalPropertiesToRemove="OutputPath;OutDir;PublishDir" />
    <ProjectReference Include="..\..\TrayAppDotNETCommon\generators\XmlSourceGenerator\TrayAppDotNETCommon.XmlSourceGenerator.csproj"
                      Condition="'$(MSBuildIsRestoring)' != 'true' or '$(PublishAot)' != 'true'"
                      Targets="$(TrayAppDotNETSharedProjectReferenceTargets)"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;SelfContained;RuntimeIdentifier;RuntimeIdentifiers;PublishSingleFile;IncludeNativeLibrariesForSelfExtract;IncludeAllContentForSelfExtract;UseAppHost;OutputPath;OutDir;PublishDir"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\TrayAppDotNETCommon\generators\AxamlPropertyLinker\TrayAppDotNETCommon.AxamlPropertyLinker.csproj"
                      Condition="'$(MSBuildIsRestoring)' != 'true' or '$(PublishAot)' != 'true'"
                      Targets="$(TrayAppDotNETSharedProjectReferenceTargets)"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;SelfContained;RuntimeIdentifier;RuntimeIdentifiers;PublishSingleFile;IncludeNativeLibrariesForSelfExtract;IncludeAllContentForSelfExtract;UseAppHost;OutputPath;OutDir;PublishDir"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)" PrivateAssets="All" Publish="True"
                      Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="HotAvalonia" Version="$(HotAvaloniaPackageVersion)" PrivateAssets="All" Publish="True"
                      Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\app.ico" Link="Assets/app.ico" Condition="Exists('$(MSBuildProjectDirectory)\..\app.ico')" />
    <AvaloniaResource Include="Visuals\map_fla-shop.com_ccby4.0.svg" Link="Visuals/map_fla-shop.com_ccby4.0.svg" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="**\*.axaml" />
    <_NativeHelpersSource Include="$(NativeHelpersSourceDirectory)\**\*" />
    <Content Include="$(NativeHelpersExecutable)"
             Condition="'$(CustomNativeMain)' != 'true'"
             Link="$(NativeHelpersFileName)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
    <NativeLibrary Include="$(NativeHelpersLibrary)"
                   Condition="'$(CustomNativeMain)' == 'true'" />
    <NativeLibrary Include="Advapi32.lib"
                   Condition="'$(CustomNativeMain)' == 'true'" />
    <NativeLibrary Include="Dxva2.lib"
                   Condition="'$(CustomNativeMain)' == 'true'" />
    <NativeLibrary Include="Shell32.lib"
                   Condition="'$(CustomNativeMain)' == 'true'" />
    <NativeLibrary Include="User32.lib"
                   Condition="'$(CustomNativeMain)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="DDCCI\monitor-database.json">
      <LogicalName>BrightnessTrayAppDotNET.DDCCI.monitor-database.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NightLightTester" />
    <InternalsVisibleTo Include="BrightnessTrayAppDotNET.Tests" />
  </ItemGroup>

  <Target Name="BuildNativeHelpers"
          BeforeTargets="PrepareForBuild"
          Inputs="@(_NativeHelpersSource)"
          Outputs="$(NativeHelpersBuildOutput)">
    <MakeDir Directories="$(NativeHelpersBuildDirectory)" />
    <Exec Command="cmake -S &quot;$(NativeHelpersSourceDirectory)&quot; -B &quot;$(NativeHelpersBuildDirectory)&quot; -A x64" />
    <Exec Condition="'$(CustomNativeMain)' == 'true'"
          Command="cmake --build &quot;$(NativeHelpersBuildDirectory)&quot; --config $(NativeHelpersConfiguration) --target BrightnessTrayAppDotNETNativeHelpersNativeAOT" />
    <Exec Condition="'$(CustomNativeMain)' != 'true'"
          Command="cmake --build &quot;$(NativeHelpersBuildDirectory)&quot; --config $(NativeHelpersConfiguration) --target BrightnessTrayAppDotNETNativeHelpers" />
    <Error Condition="!Exists('$(NativeHelpersBuildOutput)')"
           Text="Native helper output was not produced at $(NativeHelpersBuildOutput)." />
  </Target>

  <Target Name="RemoveNativeHelpersSidecarFromAOTOutput"
          BeforeTargets="PrepareForBuild;PrepareForPublish"
          Condition="'$(CustomNativeMain)' == 'true'">
    <ItemGroup>
      <_NativeHelpersStaleSidecar Include="$(TargetDir)$(NativeHelpersFileName)" />
      <_NativeHelpersStaleSidecar Include="$(PublishDir)$(NativeHelpersFileName)"
                                  Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(_NativeHelpersStaleSidecar)" />
  </Target>

  <Target Name="CleanNativeHelpers" AfterTargets="Clean">
    <RemoveDir Directories="$(NativeHelpersBuildDirectory)"
               Condition="Exists('$(NativeHelpersBuildDirectory)')" />
  </Target>

  <!-- Generate the strongly typed resource API under obj so it always matches the RESX.
       Exclude source-tree custom-tool output to prevent duplicate classes. -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>C#</StronglyTypedLanguage>
      <StronglyTypedNamespace>$(RootNamespace).Localization</StronglyTypedNamespace>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
    <Compile Remove="Localization\Strings.Designer.cs" />
  </ItemGroup>

  <Target Name="CopyHotAvaloniaRuntimeAssemblies"
          AfterTargets="Build"
          Condition="'$(HotAvalonia)' == 'true' and '$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <_HotAvaloniaCorePath>$(NuGetPackageRoot)hotavalonia.core\$(HotAvaloniaPackageVersion)\lib\netstandard2.1\HotAvalonia.Core.dll</_HotAvaloniaCorePath>
      <_HotAvaloniaXamlLoaderPath>$(NuGetPackageRoot)avalonia.markup.xaml.loader\$(AvaloniaVersion)\lib\net10.0\Avalonia.Markup.Xaml.Loader.dll</_HotAvaloniaXamlLoaderPath>
    </PropertyGroup>

    <Error Condition="!Exists('$(_HotAvaloniaCorePath)')"
           Text="HotAvalonia.Core.dll was not found at $(_HotAvaloniaCorePath)." />
    <Error Condition="!Exists('$(_HotAvaloniaXamlLoaderPath)')"
           Text="Avalonia.Markup.Xaml.Loader.dll was not found at $(_HotAvaloniaXamlLoaderPath)." />
    <ItemGroup>
      <_HotAvaloniaRuntimeAssembly Include="$(_HotAvaloniaCorePath)" />
      <_HotAvaloniaRuntimeAssembly Include="$(_HotAvaloniaXamlLoaderPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(_HotAvaloniaRuntimeAssembly)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Retries="$(CopyRetryCount)"
          RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)" />
  </Target>

  <Target Name="PublishAfterBuild" AfterTargets="Build" Condition="'$(SkipPublishAfterBuild)' != 'true' and ('$(Configuration)' == 'Release' or '$(Configuration)' == 'ReleaseWithDebugging') and '$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <_PublishOutputPath>$(IntermediateOutputPath)native-publish\</_PublishOutputPath>
    </PropertyGroup>
    <Message Importance="High" Text="Publishing Native AOT release..." />
    <RemoveDir Directories="$(_PublishOutputPath)" Condition="Exists('$(_PublishOutputPath)')" ContinueOnError="WarnAndContinue" />
    <MakeDir Directories="$(_PublishOutputPath)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -r win-x64 --no-restore -o &quot;$(_PublishOutputPath).&quot; -p:SkipPublishAfterBuild=true -p:TrayAppDotNETBuildSharedProjectReferences=false $(TrayAppDotNETPublishAggregateProperties) -p:SkipKillRunningInstance=$(SkipKillRunningInstance)" />
    <RemoveDir Directories="$(_PublishOutputPath)win-x64" Condition="Exists('$(_PublishOutputPath)win-x64')" ContinueOnError="WarnAndContinue" />
    <ItemGroup>
      <_TrayAppDotNETPublishedFile Include="$(_PublishOutputPath)**\*" Exclude="$(_PublishOutputPath)native\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TrayAppDotNETPublishedFile)"
          DestinationFiles="@(_TrayAppDotNETPublishedFile->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Retries="$(CopyRetryCount)"
          RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
          ContinueOnError="WarnAndContinue"
          Condition="'@(_TrayAppDotNETPublishedFile)' != ''" />
    <Delete Files="$(OutputPath)$(NativeHelpersFileName)"
            Condition="Exists('$(OutputPath)$(NativeHelpersFileName)')" />
    <Message Importance="High" Text="Published to $(OutputPath)" />
  </Target>
</Project>
