<ResourceDictionary
    x:Class="BrightnessTrayAppDotNET.UI.Settings.BrightnessSettingsUIResources"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Navigation glyph adjustments -->
    <sys:Double x:Key="BrightnessSettingsUI.EnvironmentalNavigationIconScale">1.05</sys:Double>
    <TranslateTransform x:Key="BrightnessSettingsUI.EnvironmentalNavigationIconTransform" Y="-1" />
    <TranslateTransform x:Key="BrightnessSettingsUI.HotkeysNavigationIconTransform" Y="1" />
</ResourceDictionary>
