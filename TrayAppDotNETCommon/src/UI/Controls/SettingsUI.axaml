<ResourceDictionary
    x:Class="TrayAppDotNETCommon.UI.Controls.SettingsUIResources"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Navigation controls -->
    <Thickness x:Key="SettingsUI.NavItemMargin">4,0</Thickness>
    <Thickness x:Key="SettingsUI.NavActionMargin">4,2</Thickness>
    <sys:Double x:Key="SettingsUI.NavIndicatorWidth">3</sys:Double>
    <sys:Double x:Key="SettingsUI.NavIndicatorHeight">16</sys:Double>
    <CornerRadius x:Key="SettingsUI.NavIndicatorCornerRadius">1.5</CornerRadius>
    <Thickness x:Key="SettingsUI.NavIndicatorMargin">0,0,8,0</Thickness>
    <CornerRadius x:Key="SettingsUI.NavItemCornerRadius">4</CornerRadius>
    <Thickness x:Key="SettingsUI.NavItemPadding">12,10</Thickness>
    <Thickness x:Key="SettingsUI.NavItemInnerMargin">0,2</Thickness>

    <!-- Windows 11 navigation variant -->
    <Color x:Key="SettingsUI.Windows11NavIndicatorColor">#A6A5A1</Color>
    <Thickness x:Key="SettingsUI.Windows11NavItemPadding">0,10</Thickness>
    <Thickness x:Key="SettingsUI.Windows11NavContentMargin">12,0,16,0</Thickness>
    <sys:Double x:Key="SettingsUI.Windows11NavIconSize">20</sys:Double>
    <sys:Double x:Key="SettingsUI.Windows11NavIconFontSize">16</sys:Double>
    <sys:Double x:Key="SettingsUI.Windows11NavIconColumnWidth">20</sys:Double>
    <Thickness x:Key="SettingsUI.Windows11NavIconMargin">0,0,0,-4</Thickness>
    <Thickness x:Key="SettingsUI.Windows11NavLabelMargin">12,0,0,0</Thickness>

    <!-- Buttons and enabled states -->
    <CornerRadius x:Key="SettingsUI.ButtonCornerRadius">4</CornerRadius>
    <sys:Double x:Key="SettingsUI.ButtonMinHeight">32</sys:Double>
    <Thickness x:Key="SettingsUI.ButtonPadding">12,6</Thickness>
    <sys:Double x:Key="SettingsUI.EnabledOpacity">1</sys:Double>
    <sys:Double x:Key="SettingsUI.DisabledOpacity">0.4</sys:Double>
    <sys:Double x:Key="SettingsUI.ControlDisabledOpacity">0.45</sys:Double>

    <!-- Toggle controls -->
    <sys:Double x:Key="SettingsUI.ToggleWidth">40</sys:Double>
    <sys:Double x:Key="SettingsUI.ToggleHeight">20</sys:Double>
    <CornerRadius x:Key="SettingsUI.ToggleTrackCornerRadius">10</CornerRadius>
    <Thickness x:Key="SettingsUI.ToggleBorderThickness">1</Thickness>
    <sys:Double x:Key="SettingsUI.ToggleThumbWidth">10</sys:Double>
    <sys:Double x:Key="SettingsUI.ToggleThumbHeight">10</sys:Double>
    <sys:Double x:Key="SettingsUI.ToggleThumbHoverSize">12</sys:Double>
    <sys:Double x:Key="SettingsUI.ToggleThumbCheckedSize">14</sys:Double>
    <CornerRadius x:Key="SettingsUI.ToggleThumbCornerRadius">7</CornerRadius>
    <Thickness x:Key="SettingsUI.ToggleThumbUncheckedMargin">5,0,0,0</Thickness>
    <Thickness x:Key="SettingsUI.ToggleThumbCheckedMargin">0,0,3,0</Thickness>

    <!-- Color swatches -->
    <sys:Double x:Key="SettingsUI.SwatchWidth">32</sys:Double>
    <sys:Double x:Key="SettingsUI.SwatchHeight">28</sys:Double>
    <CornerRadius x:Key="SettingsUI.SwatchCornerRadius">4</CornerRadius>
    <Thickness x:Key="SettingsUI.SwatchBorderThickness">1</Thickness>
    <Thickness x:Key="SettingsUI.SwatchMargin">0,0,6,0</Thickness>
    <sys:Double x:Key="SettingsUI.SwatchFallbackOpacity">0.35</sys:Double>

    <!-- Scroll host -->
    <sys:Double x:Key="SettingsUI.ScrollWheelStep">72</sys:Double>
    <sys:Double x:Key="SettingsUI.ScrollBarTotalWidth">22</sys:Double>
    <sys:Double x:Key="SettingsUI.ScrollBarCollapsedTrackWidth">12</sys:Double>
    <sys:Double x:Key="SettingsUI.ScrollBarExpansionHitTestDepthRatio">0.75</sys:Double>
    <sys:Double x:Key="SettingsUI.ScrollBarThumbMargin">4</sys:Double>
    <sys:Double x:Key="SettingsUI.ScrollBarMinThumbHeight">24</sys:Double>

    <!-- Combo boxes -->
    <Thickness x:Key="SettingsUI.ComboItemPadding">4,2</Thickness>
    <sys:Double x:Key="SettingsUI.ComboIndicatorWidth">3</sys:Double>
    <sys:Double x:Key="SettingsUI.ComboIndicatorHeight">16</sys:Double>
    <CornerRadius x:Key="SettingsUI.ComboIndicatorCornerRadius">1.5</CornerRadius>
    <sys:Double x:Key="SettingsUI.ComboIndicatorColumnWidth">3</sys:Double>
    <sys:Double x:Key="SettingsUI.ComboIndicatorGapWidth">8</sys:Double>
    <CornerRadius x:Key="SettingsUI.ComboItemCornerRadius">4</CornerRadius>
    <Thickness x:Key="SettingsUI.ComboItemInnerPadding">12,8</Thickness>
    <sys:Double x:Key="SettingsUI.ComboArrowColumnWidth">36</sys:Double>
    <sys:Double x:Key="SettingsUI.ComboDefaultMinWidth">153</sys:Double>
    <sys:Double x:Key="SettingsUI.ComboPopupMaxHeight">320</sys:Double>
    <sys:Double x:Key="SettingsUI.ComboAutoSizeExtraPadding">4</sys:Double>
    <Thickness x:Key="SettingsUI.ComboContentPadding">12,0</Thickness>
    <sys:Double x:Key="SettingsUI.ComboHeight">32</sys:Double>
    <Thickness x:Key="SettingsUI.ComboBorderThickness">0</Thickness>
    <CornerRadius x:Key="SettingsUI.ComboCornerRadius">4</CornerRadius>
    <Thickness x:Key="SettingsUI.ComboPopupScrollPadding">0</Thickness>
    <Thickness x:Key="SettingsUI.ComboPopupBorderThickness">1</Thickness>
    <CornerRadius x:Key="SettingsUI.ComboPopupCornerRadius">6</CornerRadius>
    <Thickness x:Key="SettingsUI.ComboPopupPadding">0,4</Thickness>
    <Thickness x:Key="SettingsUI.ComboPopupMargin">8</Thickness>

    <!-- Number boxes -->
    <sys:Double x:Key="SettingsUI.NumberBoxHeight">32</sys:Double>
    <sys:Double x:Key="SettingsUI.NumberBoxSpinnerColumnWidth">22</sys:Double>
    <Thickness x:Key="SettingsUI.NumberTextBorderThickness">0</Thickness>
    <sys:Double x:Key="SettingsUI.NumberTextFontSize">14</sys:Double>
    <Thickness x:Key="SettingsUI.NumberTextPadding">6,0,2,0</Thickness>
    <Thickness x:Key="SettingsUI.NumberSuffixMargin">2,0,8,0</Thickness>
    <CornerRadius x:Key="SettingsUI.NumberValueCornerRadius">4</CornerRadius>
    <sys:Double x:Key="SettingsUI.NumberSuffixPlaceholderOpacity">0.45</sys:Double>
    <sys:Double x:Key="SettingsUI.NumberSuffixFontSize">13</sys:Double>
    <sys:Double x:Key="SettingsUI.NumberValueFontSize">14</sys:Double>
    <sys:Double x:Key="SettingsUI.NumberAutoWidthReserve">32</sys:Double>
    <CornerRadius x:Key="SettingsUI.SpinnerButtonCornerRadius">2</CornerRadius>
    <sys:Double x:Key="SettingsUI.SpinnerGlyphFontSize">8</sys:Double>

    <!-- Settings page typography and cards -->
    <sys:Double x:Key="SettingsUI.SectionHeaderFontSize">22</sys:Double>
    <Thickness x:Key="SettingsUI.SectionHeaderMargin">0,0,0,16</Thickness>
    <sys:Double x:Key="SettingsUI.SubsectionHeaderFontSize">14</sys:Double>
    <Thickness x:Key="SettingsUI.SubsectionHeaderMargin">0,16,0,8</Thickness>
    <sys:Double x:Key="SettingsUI.TitleFontSize">14</sys:Double>
    <sys:Double x:Key="SettingsUI.DescriptionFontSize">12</sys:Double>
    <sys:Double x:Key="SettingsUI.DescriptionOpacity">0.8</sys:Double>
    <Thickness x:Key="SettingsUI.DescriptionMargin">0,2,8,0</Thickness>
    <Thickness x:Key="SettingsUI.RightControlMargin">16,0,0,0</Thickness>
    <CornerRadius x:Key="SettingsUI.CardCornerRadius">6</CornerRadius>
    <Thickness x:Key="SettingsUI.CardPadding">16,12</Thickness>
    <Thickness x:Key="SettingsUI.CardMargin">0,0,0,6</Thickness>

    <!-- Text boxes and caption buttons -->
    <sys:Double x:Key="SettingsUI.TextBoxHeight">32</sys:Double>
    <sys:Double x:Key="SettingsUI.TextBoxFontSize">14</sys:Double>
    <Thickness x:Key="SettingsUI.TextBoxBorderThickness">0</Thickness>
    <Thickness x:Key="SettingsUI.TextBoxPadding">4,0</Thickness>
    <sys:Double x:Key="SettingsUI.CaptionButtonWidth">46</sys:Double>
    <sys:Double x:Key="SettingsUI.CaptionButtonHeight">32</sys:Double>
    <sys:Double x:Key="SettingsUI.CaptionButtonGlyphFontSize">10</sys:Double>
</ResourceDictionary>
