<ResourceDictionary
    x:Class="TrayAppDotNETCommon.UI.Controls.CardsResources"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Shared settings cards -->
    <sys:Double x:Key="SettingsCards.NumberBoxWidth">100</sys:Double>
    <sys:Double x:Key="SettingsCards.ResetButtonSpacing">8</sys:Double>
    <Thickness x:Key="SettingsCards.RightControlMargin">16,0,0,0</Thickness>
    <Thickness x:Key="SettingsCards.CardPadding">16,12</Thickness>
    <Thickness x:Key="SettingsCards.CardMargin">0,0,0,6</Thickness>
    <sys:Double x:Key="SettingsCards.ControlDisabledOpacity">0.45</sys:Double>

    <!-- Install card progress row -->
    <sys:Double x:Key="SettingsCards.ProgressBarHeight">4</sys:Double>
    <Thickness x:Key="SettingsCards.ProgressRowMargin">0,8,8,0</Thickness>
    <Thickness x:Key="SettingsCards.ProgressStatusMargin">0,4,0,0</Thickness>

    <!-- Sub-option stacked under a card description -->
    <Thickness x:Key="SettingsCards.SubOptionMargin">0,6,0,0</Thickness>
</ResourceDictionary>
