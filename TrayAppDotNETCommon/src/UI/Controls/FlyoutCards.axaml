<ResourceDictionary
    x:Class="TrayAppDotNETCommon.UI.Controls.FlyoutCardsResources"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Flyout card buttons -->
    <Thickness x:Key="FlyoutCards.ZeroThickness">0</Thickness>
    <CornerRadius x:Key="FlyoutCards.IconButtonCornerRadius">4</CornerRadius>
    <sys:Double x:Key="FlyoutCards.TextButtonFontSize">13</sys:Double>
    <Thickness x:Key="FlyoutCards.TextButtonBorderThickness">1</Thickness>
    <CornerRadius x:Key="FlyoutCards.TextButtonCornerRadius">4</CornerRadius>
    <Thickness x:Key="FlyoutCards.TextButtonPadding">10,5</Thickness>

    <!-- Empty card slots -->
    <sys:Double x:Key="FlyoutCards.SlotCoverOpacity">0.22</sys:Double>
</ResourceDictionary>
