<ResourceDictionary
    x:Class="TrayAppDotNETCommon.UI.CommonBindingsResources"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Label-value pairs -->
    <sys:Double x:Key="CommonBindings.PairColumnWidth">76</sys:Double>
    <sys:Double x:Key="CommonBindings.PairHeaderWidth">152</sys:Double>

    <Thickness x:Key="CommonBindings.PairHeaderMargin">0,16,16,8</Thickness>
</ResourceDictionary>
