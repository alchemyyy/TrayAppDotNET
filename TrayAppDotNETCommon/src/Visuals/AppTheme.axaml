<ResourceDictionary
    x:Class="TrayAppDotNETCommon.Visuals.AppThemeResources"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:visuals="clr-namespace:TrayAppDotNETCommon.Visuals">

    <!-- Shared light and dark theme defaults -->
    <visuals:ThemeColor x:Key="AppTheme.Background" LightHex="#F3F3F3" DarkHex="#202020" />
    <visuals:ThemeColor x:Key="AppTheme.Foreground" LightHex="#000000" DarkHex="#FFFFFF" />
    <visuals:ThemeColor x:Key="AppTheme.Border" LightHex="#E0E0E0" DarkHex="#454545" />
    <visuals:ThemeColor x:Key="AppTheme.Separator" LightHex="#E5E5E5" DarkHex="#3A3A3A" />
    <visuals:ThemeColor x:Key="AppTheme.Hover" LightHex="#E9E9E9" DarkHex="#292929" />
    <visuals:ThemeColor x:Key="AppTheme.Pressed" LightHex="#DFDFDF" DarkHex="#2A2A2A" />
    <visuals:ThemeColor x:Key="AppTheme.ControlBackground" LightHex="#FFFFFF" DarkHex="#3C3C3C" />
    <visuals:ThemeColor x:Key="AppTheme.ControlBorder" LightHex="#808080" DarkHex="#444444" />
    <visuals:ThemeColor x:Key="AppTheme.DisabledForeground" LightHex="#808080" DarkHex="#808080" />
    <visuals:ThemeColor x:Key="AppTheme.Accent" LightHex="#222222" DarkHex="#DDDDDD" />
    <visuals:ThemeColor x:Key="AppTheme.Acrylic" LightHex="#D0F3F3F3" DarkHex="#D0202020" />
    <visuals:ThemeColor x:Key="AppTheme.SecondaryForeground" LightHex="#222222" DarkHex="#DDDDDD" />
    <visuals:ThemeColor x:Key="AppTheme.FooterBackground" LightHex="#E8E8E8" DarkHex="#1A1A1A" />
    <visuals:ThemeColor x:Key="AppTheme.SliderTrack" LightHex="#C0C0C0" DarkHex="#3A3A3A" />
    <visuals:ThemeColor x:Key="AppTheme.SliderProgress" LightHex="#606060" DarkHex="#6A6A6A" />
    <visuals:ThemeColor x:Key="AppTheme.SliderThumb" LightHex="#404040" DarkHex="#F0F0F0" />
    <visuals:ThemeColor x:Key="AppTheme.ButtonHover" LightHex="#D5D5D5" DarkHex="#3A3A3A" />
    <visuals:ThemeColor x:Key="AppTheme.ButtonPressed" LightHex="#CACACA" DarkHex="#4A4A4A" />
    <visuals:ThemeColor x:Key="AppTheme.IconForeground" LightHex="#222222" DarkHex="#DDDDDD" />
    <visuals:ThemeColor x:Key="AppTheme.CardBackground" LightHex="#FBFBFB" DarkHex="#2B2B2B" />
    <visuals:ThemeColor x:Key="AppTheme.TextBoxFocused" LightHex="#F5F5F5" DarkHex="#363636" />
    <visuals:ThemeColor x:Key="AppTheme.SearchListItemSelected" LightHex="#DFDFDF" DarkHex="#454545" />
    <visuals:ThemeColor x:Key="AppTheme.SearchListItemHover" LightHex="#E9E9E9" DarkHex="#292929" />
    <visuals:ThemeColor x:Key="AppTheme.ToggleSwitchOnTrack" LightHex="#5B5B5B" DarkHex="#5B5B5B" />
    <visuals:ThemeColor x:Key="AppTheme.ToggleSwitchOnThumb" LightHex="#FFFFFF" DarkHex="#FFFFFF" />
    <visuals:ThemeColor x:Key="AppTheme.CloseButtonHover" LightHex="#C42B1C" DarkHex="#C42B1C" />
    <visuals:ThemeColor x:Key="AppTheme.CloseButtonPressed" LightHex="#A42B1C" DarkHex="#A42B1C" />
    <visuals:ThemeColor x:Key="AppTheme.CloseButtonGlyphActive" LightHex="#FFFFFF" DarkHex="#FFFFFF" />
    <visuals:ThemeColor x:Key="AppTheme.FlyoutOverlayBackdrop" LightHex="#A0000000" DarkHex="#A0000000" />
    <visuals:ThemeColor x:Key="AppTheme.FlyoutShadow" LightHex="#99000000" DarkHex="#99000000" />
    <visuals:ThemeColor x:Key="AppTheme.MenuShadow" LightHex="#80000000" DarkHex="#80000000" />
    <Color x:Key="AppTheme.TextSelectionHighlightAlpha">#66000000</Color>

    <!-- Debug hover inspector palette -->
    <Color x:Key="AppTheme.DebugInspectorBackground">#1C1C1E</Color>
    <Color x:Key="AppTheme.DebugInspectorBorder">#5C5C60</Color>
    <Color x:Key="AppTheme.DebugInspectorForeground">#EBEBF0</Color>
    <Color x:Key="AppTheme.DebugInspectorSecondaryForeground">#B9B9C0</Color>
    <Color x:Key="AppTheme.DebugInspectorLive">#69D28C</Color>
    <Color x:Key="AppTheme.DebugInspectorFrozen">#FFC25C</Color>
    <Color x:Key="AppTheme.DebugInspectorHeaderBackground">#26262A</Color>
</ResourceDictionary>
