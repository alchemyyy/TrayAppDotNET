<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <AssemblyName>TrayAppDotNETCommon</AssemblyName>
    <RootNamespace>TrayAppDotNETCommon</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TrayAppDotNETIsSharedBuildProject>true</TrayAppDotNETIsSharedBuildProject>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)\..\bin\$(Configuration)\</OutputPath>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <!-- Generates TrayAppDotNETCommon.Contracts.TrayAppDotNETAppCatalog from TrayAppDotNET.Apps.props. -->
    <TrayAppDotNETEmbedAppCatalog>true</TrayAppDotNETEmbedAppCatalog>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaXaml Remove="Theming\**" />
    <Compile Remove="Theming\**" />
    <EmbeddedResource Remove="Theming\**" />
    <None Remove="Theming\**" />
  </ItemGroup>

  <!-- The generator references and AXAML additional files come from TrayAppDotNET.Parent.targets. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(TrayAppDotNETAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(TrayAppDotNETAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="$(TrayAppDotNETAvaloniaVersion)" PrivateAssets="All"
                      Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(TrayAppDotNETAvaloniaVersion)" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="$(TrayAppDotNETDotNetPackagesVersion)" />
    <PackageReference Include="SkiaSharp" Version="$(TrayAppDotNETSkiaSharpVersion)" />
  </ItemGroup>

  <!-- Generate the strongly typed resource API under obj so it always matches the RESX.
       Exclude source-tree custom-tool output to prevent duplicate classes. -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\CommonStrings.resx">
      <StronglyTypedClassName>CommonStrings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)CommonStrings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>C#</StronglyTypedLanguage>
      <StronglyTypedNamespace>$(RootNamespace).Localization</StronglyTypedNamespace>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
    <Compile Remove="Localization\CommonStrings.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TrayAppDotNETCommon.Tests" />
    <!-- TrayAppDotNETProgram.UseSettingsDirectory, the settings folder redirect of every test process -->
    <InternalsVisibleTo Include="TrayAppDotNETCommon.TestSupport" />
  </ItemGroup>

</Project>
