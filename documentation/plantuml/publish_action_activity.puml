@startuml publish_action_activity
!include dark-theme.puml
title Publish action - automatic version planning and draft release

start

partition "Manual dispatch" {
  :Optionally override the aggregate version
  and release tag;
  :Optionally list apps to force and apps to skip
  (comma-separated names from apps.json);
}

partition "Test gate" {
  :Run tests.yml: every .NET test project,
  the publish.py tests and the endpoint updater tests;
  if (Any test failed?) then (yes)
    :Fail without planning;
    stop
  else (no)
  endif
}

partition "Plan app actions" {
  :Checkout the selected ref;
  :Fetch complete Git history and tags;
  :Query published GitHub releases;

  if (Every catalog app skipped?) then (yes)
    :Fail the workflow;
    stop
  else (no)
  endif

  :Find the newest published aggregate ZIP;
  :Check shared release inputs (Common, MSBuild files,
  app catalog, global.json, legal files, publish.py)
  since the aggregate release;

  repeat
    :Select the next app from apps.json;

    if (Skip listed?) then (yes)
      if (Published package exists?) then (yes)
        :Plan "reuse" of the published package;
        note right $TINT_AMBER
          Skip takes precedence over Force.
          The release still carries the app.
        end note
      else (no)
        :Leave the app out of the release;
      endif
    else (no)
      :Find the newest published release
      containing this app's ZIP;

      if (Prior app asset exists?) then (yes)
        if (Shared inputs changed?) then (yes)
          :Relevant changes found;
        else (no)
          :Check Git history since the commit that
          package was built from, for app-folder changes
          and any deferred shared changes;
          :Ignore buildnumber.txt-only changes;
        endif

        if (Relevant changes found?) then (yes)
          :Plan "build" at max(tracked build number,
          published version + 1);
        else (no)
          if (Force listed?) then (yes)
            :Plan "build" without incrementing;
          else (no)
            :Plan "reuse";
          endif
        endif
      else (no)
        :Plan "build" at max(tracked build number, 200);
      endif
    endif
  repeat while (More apps?) is (yes)

  :Keep the original source commit unchanged;
  :Expose the source commit, the included apps
  and the release matrix (one entry per included app);
  :Build and upload the shared installer factory;
}

partition "Package included apps in parallel" {
  :Run app-release.yml once per release matrix entry;

  fork
    :Apps planned "build":
    checkout the source commit;
    :Pass the planned version and source commit
    to the build as ephemeral MSBuild properties;
    :Restore and publish the win-x64
    self-contained Native AOT app;
    :Create the versioned app ZIP;
  fork again
    :Apps planned "reuse":
    locate the last published app ZIP;
    :Download and validate the ZIP
    and its published SHA-256 digest;
  end fork

  :Stamp each app installer from the factory;
  :Write each app package manifest;
  :Upload each package as an Actions artifact;
}

partition "Assemble and publish" {
  if (Any app release job failed?) then (yes)
    :Fail without publishing the draft release;
    stop
  else (no)
  endif

  :Download every package artifact;

  :Build the aggregate ZIP from the included apps;
  note right $TINT_BLUE
    install-all.bat is generated to install
    exactly the apps the aggregate carries.
  end note

  :Stamp the suite installer;
  :Generate versions.xml, listing the included
  apps under <applications>;
  :Generate release notes with app versions,
  source commit hashes, SHA-256 checksums,
  pull requests as "title by username in PR link",
  and commits since the prior aggregate release;
  :Create or update the GitHub draft release;
  :Prune stale release assets;
  :Upload aggregate ZIP, installers, app ZIPs and versions.xml;
  :Upload the aggregate Actions artifact;
  :Delete intermediate package artifacts;
}

stop
@enduml
