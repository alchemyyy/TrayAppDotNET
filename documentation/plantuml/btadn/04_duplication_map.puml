@startuml duplication_map
' Revised 2026-07-12: DDC pipeline audit and simplification plan
' Revised 2026-10-30: shared code moved into TrayAppDotNETCommon (tray, flyout, theme, number box, hex parsing)
!include ../dark-theme.puml
title Duplication map - status of repeated code & parallel implementations

legend top right
  |= color |= meaning |
  |<$TINT_RESOLVED>| RESOLVED |
  |<$TINT_PARTIAL>| PARTIAL |
  |<$TINT_OPEN>| OPEN |
endlegend

' ----- DUP-1: WM_DEVICECHANGE listeners merged -----
package "DUP-1  WM_DEVICECHANGE listeners" $TINT_RESOLVED {
  [DisplayEventManager\n(single owner)\nsrc/Services/DisplayEventManager.cs] as D1A
  note bottom of D1A
    One HWND owns the only DeviceNotification registration.
    Fast path: DispatcherTimer 250 ms coalescer.
    Slow path: System.Threading.Timer 1 s x 10 burst.
    App.cs only consumes events; it does not register a sink.
  end note
}

' ----- DUP-2: the Common settings number box is the single numeric input -----
package "DUP-2  Numeric inputs" $TINT_RESOLVED {
  [TrayAppDotNETCommon SettingsNumberBox\n(UI/Controls/SettingsUI.cs)] as D2X
  [MonitorsPage / GeneralPage cards\n+ flyout curve stopwatch] as D2A
  D2X -[#green]- D2A : single source
}

