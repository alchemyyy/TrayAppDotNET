package "DUP-3  Curve application" $TINT_RESOLVED {
  [EnvironmentalCurveService.ApplyCurveCore\nsrc/Services/EnvironmentalCurveService.cs] as D3A
  [.ApplyBrightnessCurve / .ApplyNightLightCurve\n(thin wrappers around ApplyCurveCore)] as D3B
  D3A -[#green]- D3B : single owner
}

