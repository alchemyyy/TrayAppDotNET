package "DUP-19  Night-light spaced write discipline" $TINT_RESOLVED {
  [NightLightRegistry.EnqueueSetStrengthSpaced\n(throttled, debounced)] as D19A
  [NightLightProvider enable-from-zero path\n(calls EnqueueSetStrengthSpaced)] as D19B
  D19A -[#green]- D19B : Wave-1 fix:\nEnable-from-zero path now uses\nthe same spaced write primitive.\nNL toggle-on no longer visibly flickers.
}

' ----- DUP-20 PARTIAL: per-monitor offset capture rules -----
package "DUP-20  Per-monitor offset capture" $TINT_PARTIAL {
  [MonitorInfo.CaptureOffsetsFromMaster\n(reads LastUserBrightness)] as D20A
  [MonitorInfo.HandleCurveSliderTouch\nre-engage path\n(reads Brightness)] as D20B
  D20A -[#orange]- D20B : two parallel offset rules\nin same file. Different baseline\nfor CS->CA re-engage vs fresh\nengage. Audit_24 DUP-20 still open.
}

' ----- T-1 RESOLVED: light/dark resolution lives once, in Common -----
package "T-1  Light/dark resolution" $TINT_RESOLVED {
  [Common AppTheme.ResolveIsLight(settings or mode, theme)\n(the only light/dark resolver)] as T1X
  [App.cs / BrightnessFlyoutWindow /\nDisplayIdentifierOverlayWindow /\nsettings window palette] as T1Y
  T1X -[#green]- T1Y : per-app copies removed\n(audit 03-11); every app\nroutes through Common AppTheme
}

@enduml
