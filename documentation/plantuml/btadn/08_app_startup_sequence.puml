@startuml app_startup_sequence
!include ../dark-theme.puml
' Revised 2026-07-12: DDC recovery wake-up and fresh-helper retry behavior
' Revised 2026-10-30: Common TrayAppDotNETProgram.Run, app host, tray presenter, WatcherMonitor
title App startup - Program.Main -> TrayAppDotNETProgram.Run -> App.OnFrameworkInitializationCompleted

' Note on syntax: PlantUML parses a leading "--" inside an alt label as a sequence-arrow
' fragment, so flag names below are wrapped in quotes ("--watcher" etc) and rendered as text.

participant "Program.Main\n-> TrayAppDotNETProgram.Run\n(Common ProgramStartup)" as MAIN
participant "CrashHandler\n(--watcher proc)" as WAT
participant "SingleInstanceCoordinator"     as SIC
participant "App (Avalonia)\n+ TrayAppDotNETAppHost\n(--monitored proc)" as APP
participant "AppSettings"                   as AS
participant "StartupManager"                as SM
participant "NightLightProvider"            as NLP
participant "AppTheme"                      as AT
participant "MonitorService"                as MS
participant "DisplayEventManager"           as DEM
participant "DDCRecoveryService"            as DRS
participant "ProfileManager"                as PM
participant "TrayIconPresenter\n(Common)"   as TIM
participant "BrightnessFlyout"              as BFL
participant "EnvironmentalCurveService"     as ECS
participant "MonitorBrightnessRangeProvider" as MBR
participant "GlobalHotkeyService"           as GHS
participant "UpdateCheckService\n(GitHub poller)" as UCS

== TrayAppDotNETProgram.Run: branch on argv ==

MAIN -> MAIN : apply "--settings-dir" (exit 2 when unusable)

alt "--watcher" (running as crash handler)
  MAIN -> WAT : CrashHandler.RunWatcher(forwarded launch args)
  WAT -> SIC : AcquireOrTakeover()\n(graceful exit request first,\nverified kill only after the timeout)
  WAT -> APP : LaunchApplication("--monitored --watcher-pid <PID>" + forwarded args)
  WAT -> WAT : wait + restart loop\n(stop on exit 0/1; exit 3 only while\nWindows ends the session; cap rapid restarts)
end

alt no flag, no debugger, no TrayAppDotNET_NO_WATCHER
  MAIN -> WAT : LaunchWatcherDetached()\n(starts "<exe> --watcher" hidden); exit 0
end

MAIN -> MAIN : TADNLog.Initialize(app data folder)\nhook ProcessExit -> release + Flush
MAIN -> MAIN : UpdateInstaller.TryRun ("--update-apply" / "--update-restart")

alt "--install-system" / "--sync-start-menu" / "--uninstall-prepare" / headless install or uninstall
  MAIN -> MAIN : run the install command; exit with its code
end

alt "--installer" / "--uninstall <dir> --scope <scope>"
  MAIN -> MAIN : set IsInstallerMode / IsUninstallerMode
end

== Monitored path (or debugger attached) ==

MAIN -> MAIN : WatcherPID = ParseWatcherPID(args)\nacquire single-instance + application mutexes
MAIN -> APP : options.RunApplication\n-> TrayAppDotNETAppRunner.Run<App>\n(rendering backend + language read in one pass, STA)

== App.OnFrameworkInitializationCompleted ==

APP -> APP : host.InitializeShell()\n(logging, localization, crash handlers)

alt host.TryRunAuxiliaryMode() (installer or uninstaller mode)
  APP -> AS  : ReadOrDefault (styling only; nothing saved)
  APP -> AT  : LoadOrDefault
  APP -> APP : show the Common installer / uninstaller window
  note right of APP
    No tray, no monitors,
    no hotkeys, no startup shortcut,
    no app cleanup wired.
  end note
end

APP -> AS  : host.BeginTrayMode(ConfigureSettings, ConfigureTheme)\nLoadOrDefault (missing / corrupt / locked handled\nby the Common settings store)
alt first run (no settings.xml)
  APP -> SM : create the Run on startup shortcut
end
APP -> APP : ConfigureSettings: settings.Changed += OnSettingsChanged
APP -> AT  : ConfigureTheme: ThemeChanged subscribe\nApplyThemeVariant + ApplyThemeResources

APP -> NLP : StartServices: Initialize(_settings)\n(tray mode only; re-applies a saved tint)
APP -> APP : ApplyPDBDownloadTimeout(_settings)\n(clamped -> PDBSymbolResolver.DownloadTimeout)

APP -> MS  : new MonitorService(new DisplayService(), _settings, KnownDisplaysStore)\nMonitorsRefreshed += OnMonitorsRefreshed
MS  -> MS  : ScheduleStartupRecoverySweep()\n(2s/5s ticks, gated on KnownDisplays;\n re-Refresh until every WasEverDDCCapable\n panel is IsDDCCISupported)

APP -> DEM : new DisplayEventManager(_monitorService, ProfileManager.GetDefaultPath())\nDisplayTopologyChanged += OnDisplayTopologyChanged\nStart()
note right of DEM
  message-only HWND:
  WM_DEVICECHANGE,
  WM_DISPLAYCHANGE,
  resume-from-suspend,
  + slow-path SetupAPI burst
end note

APP -> DRS : new DDCRecoveryService(_monitorService) + Start()\n(subscribe to DDCRecoveryRequested + MonitorsRefreshed;\nno worker unless candidates exist)

APP -> PM  : new ProfileManager(ProfileManager.GetDefaultPath())\nAppServices.ProfileManager = pm

APP -> GHS : host.StartHotkeyService\nInitialize() (message-only window on UI thread)\nFired += OnHotkeyFired\nApply(_settings.Hotkeys)\n(a service whose Initialize throws is never published)

APP -> TIM : CreateTrayIcon()\n(TrayAppDotNETShellTrayIcon + TrayIconPresenter +\nTrayWindowToggle + TrayMenuController)\nLeftClick / LeftDoubleClick / KeySelect / RightClick /\nScrolled / RefreshNeeded / BalloonClicked
APP -> UCS : host.StartCommonServices\n(WatcherMonitor: waits on the watcher's process handle;\n update checks + notifications; exit request listener)
APP -> APP : RequestTrayRefresh()

APP -> MBR : new MonitorBrightnessRangeProvider(_monitorService)

note over MS, BFL $TINT_GREEN
  Refresh() at MonitorService ctor performs Phase A
  synchronously, then starts Phase B immediately for
  cold start or after the 1500 ms settle window for a
  recent topology event.

  Phase B's retrying VCP reads run off the dispatcher.
  The flyout may therefore wire up against an empty or
  partial Monitors collection. AttachMonitor is the
  event-driven per-row repair path: it restores profile
  brightness for curve-on slider intent or
  ApplyBrightnessOnStartup, and initializes only the
  newly attached row's Offset.

  Probe and projection are read-only: bounds/norm projection installs
  metadata, and hardware-read hydration uses write suspension.
  After timing / bounds / norm projections, MonitorService publishes
  MonitorsRefreshed so EnvironmentalCurveService can finalize ownership.
  It then forces one current manual or curve owner target through
  ReplayRecoveredBrightnessIntent and normal matching read-back.

  When the flyout started with an empty monitor collection,
  BrightnessFlyout performs one startup-only rebaseline on
  the first MonitorsRefreshed before EnvironmentalCurveService
  evaluates. That removes offsets created against the rolling
  persisted master during staggered per-row attach.
end note

== Phase B: immediate cold start or deferred topology ==
MS -> MS  : RefreshProbePhaseAsync\n(consumes Phase A snapshot;\n  _refreshGen guards stale async continuations)
loop per enumerated monitor
  MS -> MS  : TryReadBrightnessWithRetryAsync\n(Task.Run; 80/160/480 backoff;\nfailed GET retires only that helper process)
  MS -> BFL : Monitors.Add(info) fires\nCollectionChanged synchronously
  BFL -> BFL : AttachMonitor:\nprofile restore if needed\n+ InitializeOffsetFromMaster(new row only)\n+ UpdateMasterFromEnabledIndividuals(isUserIntent: false)\n(inside _suppressPropagation scope)
end
MS -> MS  : ResortMonitors -> per-row Move events
MS -> BFL : (each Move re-enters OnMonitorsCollectionChanged)
MS -> APP : MonitorsRefreshed fan-out
MS -> APP : App.OnMonitorsRefreshed\n(reapply per-monitor bindings,\ninvalidate tray menu, refresh icon)
MS -> BFL : OnInitialMonitorEnrollmentRefreshed\n(startup-only master/offset rebaseline)
MS -> ECS : OnMonitorsRefreshed -> Evaluate()
ECS -> ECS : HarmonizeRow per monitor\n(Enabled -> CurveActive / CurveSleeping)
ECS -> MS : EnqueueDirectBrightness per row\n(curve targets)
MS -> DRS : OnMonitorsRefreshed (reconcile candidates)\nDDCRecoveryRequested(id) directly wakes on demotion
MS -> MBR : Resubscribe
MS -> MS  : ReplayRecoveredBrightnessIntent(acquired rows)\n(after synchronous subscribers; force final owner target)
MS -> MS  : Immediate scheduler -> SET + matching read-back\n(recovery/acquisition GET is readability evidence only)

== T+2000 ms and T+5000 ms: startup recovery sweep ==
MS -> MS  : ScheduleStartupRecoverySweep ticks\n(gated on KnownDisplays;\n re-Refresh until every WasEverDDCCapable\n panel is IsDDCCISupported)
note right of MS
  Each sweep fires a fresh Phase B.
  Refresh now has _refreshGen reentrancy guard
  (H-01 fix) so a sweep1 Phase B that arrives
  while Phase B(initial) is mid-flight drops
  rather than racing the snapshot.
end note

note over APP, GHS
  Subscriptions wired in App.cs:
   - AppSettings.Changed
   - AppTheme.ThemeChanged
   - DisplayEventManager.DisplayTopologyChanged
   - GlobalHotkeyService.Fired
   - MonitorService.MonitorsRefreshed (hotkey reattach)
   - UpdateCheckService.StateChanged
     (OnUpdateStateChanged -> flyout NotifyUpdateStateChanged
      + tray balloon for new versions; cf410f7)
   - TrayAppDotNETShellTrayIcon events
     (LeftClick, LeftDoubleClick, KeySelect, RightClick,
      Scrolled, PrecisionTouchpadScrolled, RefreshNeeded)
     + BalloonClicked
     (OnUpdateBalloonClicked -> ShowBrightnessFlyout
      + RequestUpdatePrompt)
   - BrightnessFlyout events
     (BrightnessUpdated, SettingsRequested)
     re-wired when the flyout is recreated
   - SettingsWindow.Closed (lazy, on first OpenSettings)
end note

note over AS $TINT_BLUE
  Settings go through the Common TrayXmlFileStore:
  atomic temp+replace writes (AtomicFile), one writer,
  failures logged. A corrupt file is moved aside as
  settings.xml.corrupt-<UTC>; a locked file is left
  alone and nothing is saved that session.
end note

@enduml
