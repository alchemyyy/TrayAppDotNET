<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test properties, test packages, the app reference and the shared helpers (TrayAppDotNETUseTestSupport) come
       from TrayAppDotNET.Parent.props and TrayAppDotNET.Parent.targets. -->
  <PropertyGroup>
    <TrayAppDotNETUseTestSupport>true</TrayAppDotNETUseTestSupport>
    <!-- Like the app, Visual Studio references the vendored assemblies by output path. LibreHardwareMonitorLib only defines that
         path for Debug and Release, so every other configuration (Prerelease, ReleaseWithDebugging) builds and
         references the Release vendor output. -->
    <FanControlVendoredConfiguration Condition="'$(Configuration)' == 'Debug'">Debug</FanControlVendoredConfiguration>
    <FanControlVendoredConfiguration Condition="'$(Configuration)' != 'Debug'">Release</FanControlVendoredConfiguration>
    <FanControlNCalcAotOutputPath>$(MSBuildProjectDirectory)\..\..\vendor\NCalc\src\NCalc.AOT\bin\x64\$(FanControlVendoredConfiguration)\net10.0\</FanControlNCalcAotOutputPath>
    <FanControlLibreHardwareMonitorOutputPath>$(MSBuildProjectDirectory)\..\..\vendor\LibreHardwareMonitor\bin\$(FanControlVendoredConfiguration)\x64\net10.0\</FanControlLibreHardwareMonitorOutputPath>
    <FanControlUseVendoredAssemblyReferences Condition="'$(DesignTimeBuild)' == 'true' or '$(BuildingInsideVisualStudio)' == 'true'">true</FanControlUseVendoredAssemblyReferences>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same metadata as the app's reference, so both resolve to one LHM build. With any difference MSBuild
         builds LHM twice in parallel into the same obj folder, and a clean build fails with CS2012 on
         LibreHardwareMonitorLib.dll. -->
    <ProjectReference Include="..\..\vendor\LibreHardwareMonitor\LibreHardwareMonitorLib\LibreHardwareMonitorLib.csproj"
                      Condition="'$(FanControlUseVendoredAssemblyReferences)' != 'true'">
      <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
      <SetPlatform>Platform=x64</SetPlatform>
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
      <AdditionalProperties>DisableIpmiWmi=true;DisableRamSpd=true;$(TrayAppDotNETPrereleaseProjectProperties)</AdditionalProperties>
      <GlobalPropertiesToRemove>BuildOnlyRefs;PublishAot;PublishSingleFile;SelfContained;PublishTrimmed;OutputPath;OutDir;PublishDir</GlobalPropertiesToRemove>
      <Private>true</Private>
      <PrivateAssets>all</PrivateAssets>
      <Visible>false</Visible>
    </ProjectReference>
    <!-- NCalc is private in the app graph, but tests execute app code that loads it. -->
    <ProjectReference Include="..\..\vendor\NCalc\src\NCalc.AOT\NCalc.AOT.csproj"
                      Condition="'$(FanControlUseVendoredAssemblyReferences)' != 'true'">
      <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
      <SetPlatform>Platform=x64</SetPlatform>
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
      <AdditionalProperties>TreatWarningsAsErrors=false;$(TrayAppDotNETPrereleaseProjectProperties)</AdditionalProperties>
      <GlobalPropertiesToRemove>BuildOnlyRefs;PublishAot;PublishSingleFile;SelfContained;PublishTrimmed;RuntimeIdentifier;RuntimeIdentifiers;OutputPath;OutDir;PublishDir</GlobalPropertiesToRemove>
      <Private>true</Private>
      <PrivateAssets>all</PrivateAssets>
      <Visible>false</Visible>
    </ProjectReference>
    <Reference Include="LibreHardwareMonitorLib" Condition="'$(FanControlUseVendoredAssemblyReferences)' == 'true'">
      <HintPath>$(FanControlLibreHardwareMonitorOutputPath)LibreHardwareMonitorLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NCalc.AOT" Condition="'$(FanControlUseVendoredAssemblyReferences)' == 'true'">
      <HintPath>$(FanControlNCalcAotOutputPath)NCalc.AOT.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Parlot" Condition="'$(FanControlUseVendoredAssemblyReferences)' == 'true'">
      <HintPath>$(FanControlNCalcAotOutputPath)Parlot.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
