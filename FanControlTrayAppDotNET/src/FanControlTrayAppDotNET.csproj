<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>FanControlTrayAppDotNET</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <StartupObject>FanControlTrayAppDotNET.Program</StartupObject>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)\..\bin\$(Configuration)\</OutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaVersion>12.0.4</AvaloniaVersion>
    <HotAvaloniaPackageVersion>3.1.1</HotAvaloniaPackageVersion>
    <HotAvaloniaAutoEnable>false</HotAvaloniaAutoEnable>
    <HotAvaloniaMode>Balanced</HotAvaloniaMode>
    <ApplicationIcon Condition="Exists('$(MSBuildProjectDirectory)\..\app.ico')">..\app.ico</ApplicationIcon>
    <_DefaultTrayAppDotNETCommonRoot>$(MSBuildProjectDirectory)\..\..\TrayAppDotNETCommon</_DefaultTrayAppDotNETCommonRoot>
    <_DefaultTrayAppDotNETCommonProject>$(_DefaultTrayAppDotNETCommonRoot)\src\TrayAppDotNETCommon.csproj</_DefaultTrayAppDotNETCommonProject>
    <TrayAppDotNETCommonRoot Condition="'$(TrayAppDotNETCommonRoot)' == ''">$(_DefaultTrayAppDotNETCommonRoot)</TrayAppDotNETCommonRoot>
    <TrayAppDotNETCommonProject Condition="'$(TrayAppDotNETCommonProject)' == ''">$(TrayAppDotNETCommonRoot)\src\TrayAppDotNETCommon.csproj</TrayAppDotNETCommonProject>
    <FanControlDesignTimeNCalcCoreOutputPath>$(MSBuildProjectDirectory)\..\vendor\NCalc\src\NCalc.Core\bin\x64\$(Configuration)\net10.0\</FanControlDesignTimeNCalcCoreOutputPath>
    <FanControlDesignTimeNCalcDomainOutputPath>$(MSBuildProjectDirectory)\..\vendor\NCalc\src\NCalc.Domain\bin\x64\$(Configuration)\net10.0\</FanControlDesignTimeNCalcDomainOutputPath>
    <FanControlDesignTimeNCalcParserOutputPath>$(MSBuildProjectDirectory)\..\vendor\NCalc\src\NCalc.Parser\bin\x64\$(Configuration)\net10.0\</FanControlDesignTimeNCalcParserOutputPath>
    <FanControlDesignTimeLibreHardwareMonitorOutputPath>$(MSBuildProjectDirectory)\..\vendor\LibreHardwareMonitor\bin\$(Configuration)\x64\net10.0\</FanControlDesignTimeLibreHardwareMonitorOutputPath>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <EnableGeneratedComInterfaceComImportInterop>true</EnableGeneratedComInterfaceComImportInterop>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and ('$(Configuration)' == 'Release' or '$(Configuration)' == 'ReleaseWithDebugging')">
    <DisableParlotParserCompilation>true</DisableParlotParserCompilation>
  </PropertyGroup>

  <!-- Debug LHM uses Mono.Posix.NETStandard through its OpCode path. Keep this enabled
       so Debug deps files include package runtime assets in both root and per-app layouts. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(RuntimeIdentifier)' == ''">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Visuals\FanFont.ttf" />
    <None Remove="Visuals\FAN_GLYPH.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.9" PrivateAssets="all" IsImplicitlyDefined="true" />
    <IlcArg Include="--substitution:$(MSBuildProjectDirectory)\NativeAotSubstitutions.xml" Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''" />
    <Using Include="TrayAppDotNETCommon.TADNLog" Alias="TADNLog" />
    <Using Include="TrayAppDotNETCommon" />
    <Using Include="TrayAppDotNETCommon.Interop" />
    <Using Include="TrayAppDotNETCommon.Localization" />
    <Using Include="TrayAppDotNETCommon.Models" />
    <Using Include="TrayAppDotNETCommon.Services" />
    <Using Include="TrayAppDotNETCommon.Services.Install" />
    <Using Include="TrayAppDotNETCommon.UI" />
    <Using Include="TrayAppDotNETCommon.UI.Controls" />
    <Using Include="TrayAppDotNETCommon.UI.Hotkeys" />
    <Using Include="TrayAppDotNETCommon.UI.Models" />
    <Using Include="TrayAppDotNETCommon.UI.Tray" />
    <Using Include="TrayAppDotNETCommon.Utils" />
    <Using Include="FanControlTrayAppDotNET" />
    <Using Include="FanControlTrayAppDotNET.Models" />
    <Using Include="FanControlTrayAppDotNET.Visuals" />
    <ProjectReference Include="$(TrayAppDotNETCommonProject)"
                      Targets="$(TrayAppDotNETSharedProjectReferenceTargets)"
                      GlobalPropertiesToRemove="OutputPath;OutDir;PublishDir" />
    <ProjectReference Include="..\..\TrayAppDotNETCommon\generators\XmlSourceGenerator\TrayAppDotNETCommon.XmlSourceGenerator.csproj"
                      Condition="'$(MSBuildIsRestoring)' != 'true' or '$(PublishAot)' != 'true'"
                      Targets="$(TrayAppDotNETSharedProjectReferenceTargets)"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;SelfContained;RuntimeIdentifier;RuntimeIdentifiers;PublishSingleFile;IncludeNativeLibrariesForSelfExtract;IncludeAllContentForSelfExtract;UseAppHost;OutputPath;OutDir;PublishDir"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all" />
    <ProjectReference Include="..\..\TrayAppDotNETCommon\generators\AxamlPropertyLinker\TrayAppDotNETCommon.AxamlPropertyLinker.csproj"
                      Condition="'$(MSBuildIsRestoring)' != 'true' or '$(PublishAot)' != 'true'"
                      Targets="$(TrayAppDotNETSharedProjectReferenceTargets)"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;SelfContained;RuntimeIdentifier;RuntimeIdentifiers;PublishSingleFile;IncludeNativeLibrariesForSelfExtract;IncludeAllContentForSelfExtract;UseAppHost;OutputPath;OutDir;PublishDir"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all" />
    <!-- Visual Studio restore rejects ProjectReference items whose projects are not in
         the loaded solution. Use metadata references for design-time only, pointing at
         the real vendor outputs, so VS/ReSharper resolve NCalc and LHM without trying
         to restore unloaded submodule projects. -->
    <Reference Include="LibreHardwareMonitorLib" Condition="'$(DesignTimeBuild)' == 'true' and Exists('$(FanControlDesignTimeLibreHardwareMonitorOutputPath)LibreHardwareMonitorLib.dll')">
      <HintPath>$(FanControlDesignTimeLibreHardwareMonitorOutputPath)LibreHardwareMonitorLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DiskInfoToolkit" Condition="'$(DesignTimeBuild)' == 'true' and Exists('$(FanControlDesignTimeLibreHardwareMonitorOutputPath)DiskInfoToolkit.dll')">
      <HintPath>$(FanControlDesignTimeLibreHardwareMonitorOutputPath)DiskInfoToolkit.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HidSharp" Condition="'$(DesignTimeBuild)' == 'true' and Exists('$(FanControlDesignTimeLibreHardwareMonitorOutputPath)HidSharp.dll')">
      <HintPath>$(FanControlDesignTimeLibreHardwareMonitorOutputPath)HidSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NCalc.Core" Condition="'$(DesignTimeBuild)' == 'true' and Exists('$(FanControlDesignTimeNCalcCoreOutputPath)NCalc.Core.dll')">
      <HintPath>$(FanControlDesignTimeNCalcCoreOutputPath)NCalc.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NCalc.Domain" Condition="'$(DesignTimeBuild)' == 'true' and Exists('$(FanControlDesignTimeNCalcDomainOutputPath)NCalc.Domain.dll')">
      <HintPath>$(FanControlDesignTimeNCalcDomainOutputPath)NCalc.Domain.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NCalc.Parser" Condition="'$(DesignTimeBuild)' == 'true' and Exists('$(FanControlDesignTimeNCalcParserOutputPath)NCalc.Parser.dll')">
      <HintPath>$(FanControlDesignTimeNCalcParserOutputPath)NCalc.Parser.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Normal builds use hidden source references plus the serial prebuild targets
         below. Do not use these ProjectReferences for design-time builds; VS restore
         needs loaded solution projects for ProjectReference metadata. -->
    <ProjectReference Include="..\vendor\LibreHardwareMonitor\LibreHardwareMonitorLib\LibreHardwareMonitorLib.csproj"
                      Condition="'$(DesignTimeBuild)' != 'true'">
      <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
      <SetPlatform>Platform=x64</SetPlatform>
      <!-- Keep non-fan LHM probes out of Debug too. Fan control uses PawnIO/LPC; IPMI/BMC
           and RAM SPD pull System.Management and can fail before normal sensors enumerate. -->
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
      <AdditionalProperties>DisableIpmiWmi=true;DisableRamSpd=true</AdditionalProperties>
      <GlobalPropertiesToRemove>BuildOnlyRefs;PublishAot;PublishSingleFile;SelfContained;PublishTrimmed;OutputPath;OutDir;PublishDir</GlobalPropertiesToRemove>
      <Private>true</Private>
      <PrivateAssets>all</PrivateAssets>
      <Visible>false</Visible>
    </ProjectReference>
    <ProjectReference Include="..\vendor\NCalc\src\NCalc.Core\NCalc.Core.csproj"
                      Condition="'$(DesignTimeBuild)' != 'true'">
      <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
      <SetTargetFramework Condition="'$(RuntimeIdentifier)' == '' or ('$(Configuration)' != 'Release' and '$(Configuration)' != 'ReleaseWithDebugging')">TargetFramework=net10.0</SetTargetFramework>
      <SetTargetFramework Condition="'$(RuntimeIdentifier)' != '' and ('$(Configuration)' == 'Release' or '$(Configuration)' == 'ReleaseWithDebugging')">TargetFramework=net10.0;DisableParlotParserCompilation=true</SetTargetFramework>
      <AdditionalProperties>TreatWarningsAsErrors=false;NoWarn=RCS1194</AdditionalProperties>
      <GlobalPropertiesToRemove>BuildOnlyRefs;PublishAot;PublishSingleFile;SelfContained;PublishTrimmed;RuntimeIdentifier;RuntimeIdentifiers;OutputPath;OutDir;PublishDir</GlobalPropertiesToRemove>
      <Private>true</Private>
      <PrivateAssets>all</PrivateAssets>
      <Visible>false</Visible>
    </ProjectReference>
    <ProjectReference Include="..\vendor\NCalc\src\NCalc.Domain\NCalc.Domain.csproj"
                      Condition="'$(DesignTimeBuild)' != 'true'"
                      Targets="GetTargetPath">
      <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
      <AdditionalProperties>TreatWarningsAsErrors=false</AdditionalProperties>
      <GlobalPropertiesToRemove>BuildOnlyRefs;PublishAot;PublishSingleFile;SelfContained;PublishTrimmed;RuntimeIdentifier;RuntimeIdentifiers;OutputPath;OutDir;PublishDir</GlobalPropertiesToRemove>
      <Private>true</Private>
      <PrivateAssets>all</PrivateAssets>
      <Visible>false</Visible>
    </ProjectReference>
    <PackageReference Include="BlackSharp.Core" Version="1.1.0" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)" PrivateAssets="All" Publish="True" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="HotAvalonia" Version="$(HotAvaloniaPackageVersion)" PrivateAssets="All" Publish="True" />
    <!-- Required for Debug LHM startup. Release disables the native paths that need this,
         but Debug must declare the package so the .deps.json can resolve it. -->
    <PackageReference Include="Mono.Posix.NETStandard" Version="1.0.0" Condition="'$(Configuration)' == 'Debug' and '$(RuntimeIdentifier)' == ''" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\app.ico" Link="Assets/app.ico" Condition="Exists('$(MSBuildProjectDirectory)\..\app.ico')" />
    <AvaloniaResource Include="Visuals\FanFont.ttf" Link="Visuals/FanFont.ttf" />
    <AvaloniaResource Include="Visuals\FAN_GLYPH.png" Link="Visuals/FAN_GLYPH.png" />
    <Content Include="Resources\PawnIO_setup.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="**\*.axaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Localization\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <Target Name="KillRunningInstance" BeforeTargets="BeforeBuild;BeforeClean">
    <Exec Command="taskkill /F /IM $(AssemblyName).exe /T" ContinueOnError="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low" Condition="'$(SkipKillRunningInstance)' != 'true'" />
  </Target>

  <!-- Visual Studio resolves hidden vendored ProjectReference items with GetTargetPath,
       so clean builds need a real build pass before dependency generation. -->
  <Target Name="BuildVendoredProjectReferencesInVisualStudio"
          BeforeTargets="ResolveProjectReferences"
          Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(FanControlBuildVendoredProjectReferencesInVisualStudio)' != 'false'">
    <PropertyGroup>
      <_VendoredReferenceBuildProperties>Configuration=$(Configuration);BuildingInsideVisualStudio=false;BuildProjectReferences=true;GeneratePackageOnBuild=false</_VendoredReferenceBuildProperties>
      <_VendoredReferenceBuildProperties>$(_VendoredReferenceBuildProperties);SkipKillRunningInstance=$(SkipKillRunningInstance)</_VendoredReferenceBuildProperties>
      <_VendoredReferencePropertiesToRemove>BuildOnlyRefs;PublishAot;PublishSingleFile;SelfContained;PublishTrimmed;OutputPath;OutDir;PublishDir</_VendoredReferencePropertiesToRemove>
      <!-- Match the normal ProjectReference: VS-triggered prebuilds must not compile
           IPMI/BMC or RAM SPD paths into the Debug LHM sidecar. -->
      <_LibreHardwareMonitorBuildProperties Condition="'$(RuntimeIdentifier)' == '' or ('$(Configuration)' != 'Release' and '$(Configuration)' != 'ReleaseWithDebugging')">TargetFramework=net10.0;DisableIpmiWmi=true;DisableRamSpd=true</_LibreHardwareMonitorBuildProperties>
      <_LibreHardwareMonitorBuildProperties Condition="'$(RuntimeIdentifier)' != '' and ('$(Configuration)' == 'Release' or '$(Configuration)' == 'ReleaseWithDebugging')">TargetFramework=net10.0;DisableIpmiWmi=true;DisableRamSpd=true</_LibreHardwareMonitorBuildProperties>
      <_NCalcCoreBuildProperties Condition="'$(RuntimeIdentifier)' == '' or ('$(Configuration)' != 'Release' and '$(Configuration)' != 'ReleaseWithDebugging')">TargetFramework=net10.0;TreatWarningsAsErrors=false;NoWarn=RCS1194</_NCalcCoreBuildProperties>
      <_NCalcCoreBuildProperties Condition="'$(RuntimeIdentifier)' != '' and ('$(Configuration)' == 'Release' or '$(Configuration)' == 'ReleaseWithDebugging')">TargetFramework=net10.0;DisableParlotParserCompilation=true;TreatWarningsAsErrors=false;NoWarn=RCS1194</_NCalcCoreBuildProperties>
    </PropertyGroup>

    <MSBuild Projects="..\vendor\LibreHardwareMonitor\LibreHardwareMonitorLib\LibreHardwareMonitorLib.csproj"
             Targets="Build"
             BuildInParallel="$(BuildInParallel)"
             Properties="$(_VendoredReferenceBuildProperties);Platform=x64;$(_LibreHardwareMonitorBuildProperties)"
             RemoveProperties="$(_VendoredReferencePropertiesToRemove)" />
    <MSBuild Projects="..\vendor\NCalc\src\NCalc.Core\NCalc.Core.csproj"
             Targets="Build"
             BuildInParallel="$(BuildInParallel)"
             Properties="$(_VendoredReferenceBuildProperties);Platform=$(Platform);$(_NCalcCoreBuildProperties)"
             RemoveProperties="$(_VendoredReferencePropertiesToRemove);RuntimeIdentifier;RuntimeIdentifiers" />
  </Target>

  <!-- NCalc.Core exposes NCalc.Domain types in public APIs. Keep a direct
       reference for compile metadata and build it serially here so clean
       Debug rebuilds do not race the transitive NCalc.Core build. -->
  <Target Name="BuildNCalcDomainReference"
          BeforeTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\vendor\NCalc\src\NCalc.Domain\NCalc.Domain.csproj"
             Targets="Build"
             BuildInParallel="$(BuildInParallel)"
             Properties="Configuration=$(Configuration);Platform=x64;TargetFramework=net10.0;BuildingInsideVisualStudio=false;BuildProjectReferences=true;GeneratePackageOnBuild=false;TreatWarningsAsErrors=false"
             RemoveProperties="BuildOnlyRefs;PublishAot;PublishSingleFile;SelfContained;PublishTrimmed;RuntimeIdentifier;RuntimeIdentifiers;OutputPath;OutDir;PublishDir" />
  </Target>

  <Target Name="IncludeLibreHardwareMonitorSidecar" AfterTargets="ComputeFilesToPublish" Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_LibreHardwareMonitorSidecar Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'LibreHardwareMonitorLib' and '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>

    <Error Condition="'@(_LibreHardwareMonitorSidecar)' == ''" Text="LibreHardwareMonitorLib.dll sidecar was not found for Native AOT publish." />

    <ItemGroup>
      <ResolvedFileToPublish Include="@(_LibreHardwareMonitorSidecar)" RelativePath="LibreHardwareMonitorLib.dll" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <Target Name="IncludePawnIoSetupSidecar" AfterTargets="ComputeFilesToPublish" Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_PawnIoSetupPath>$(MSBuildProjectDirectory)\Resources\PawnIO_setup.exe</_PawnIoSetupPath>
    </PropertyGroup>

    <Error Condition="!Exists('$(_PawnIoSetupPath)')" Text="PawnIO_setup.exe sidecar was not found for Native AOT publish." />

    <ItemGroup>
      <ResolvedFileToPublish Include="$(_PawnIoSetupPath)" RelativePath="Resources\PawnIO_setup.exe" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <Target Name="CopyHotAvaloniaRuntimeAssemblies" AfterTargets="Build" Condition="'$(HotAvalonia)' == 'true' and '$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <_HotAvaloniaCorePath>$(NuGetPackageRoot)hotavalonia.core\$(HotAvaloniaPackageVersion)\lib\netstandard2.1\HotAvalonia.Core.dll</_HotAvaloniaCorePath>
      <_HotAvaloniaXamlLoaderPath>$(NuGetPackageRoot)avalonia.markup.xaml.loader\$(AvaloniaVersion)\lib\net10.0\Avalonia.Markup.Xaml.Loader.dll</_HotAvaloniaXamlLoaderPath>
    </PropertyGroup>

    <Error Condition="!Exists('$(_HotAvaloniaCorePath)')" Text="HotAvalonia.Core.dll was not found at $(_HotAvaloniaCorePath)." />
    <Error Condition="!Exists('$(_HotAvaloniaXamlLoaderPath)')" Text="Avalonia.Markup.Xaml.Loader.dll was not found at $(_HotAvaloniaXamlLoaderPath)." />
    <ItemGroup>
      <_HotAvaloniaRuntimeAssembly Include="$(_HotAvaloniaCorePath)" />
      <_HotAvaloniaRuntimeAssembly Include="$(_HotAvaloniaXamlLoaderPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(_HotAvaloniaRuntimeAssembly)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Retries="$(CopyRetryCount)" RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)" />
  </Target>

  <Target Name="CopyRuntimeReferencesToAggregateDebugOutput" AfterTargets="Build" Condition="'$(TrayAppDotNETUseRootOutput)' == 'true' and '$(Configuration)' == 'Debug' and '$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <_AggregateDebugRuntimeReference Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' != '.xml'" />
      <_AggregateDebugRuntimeReferenceWithDestination Include="@(_AggregateDebugRuntimeReference)" Condition="'%(_AggregateDebugRuntimeReference.DestinationSubPath)' != ''" />
      <_AggregateDebugRuntimeReferenceWithDestination Include="@(_AggregateDebugRuntimeReference)" Condition="'%(_AggregateDebugRuntimeReference.DestinationSubPath)' == ''">
        <DestinationSubPath>%(Filename)%(Extension)</DestinationSubPath>
      </_AggregateDebugRuntimeReferenceWithDestination>
    </ItemGroup>

    <Copy SourceFiles="@(_AggregateDebugRuntimeReferenceWithDestination)"
          DestinationFiles="@(_AggregateDebugRuntimeReferenceWithDestination->'$(TargetDir)%(DestinationSubPath)')"
          SkipUnchangedFiles="true"
          Retries="$(CopyRetryCount)"
          RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
          Condition="'@(_AggregateDebugRuntimeReferenceWithDestination)' != ''" />
  </Target>

  <!-- Mono.Posix.NETStandard's Windows asset lands under runtimes\win-x64.
       Copy it beside the app because LHM loads it by simple assembly name at runtime. -->
  <Target Name="CopyLibreHardwareMonitorDebugRuntimeAssemblies" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' and '$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <_LibreHardwareMonitorDebugRuntimeAssembly Include="$(TargetDir)runtimes\win-x64\lib\netstandard2.0\Mono.Posix.NETStandard.dll" Condition="Exists('$(TargetDir)runtimes\win-x64\lib\netstandard2.0\Mono.Posix.NETStandard.dll')" />
    </ItemGroup>

    <Copy SourceFiles="@(_LibreHardwareMonitorDebugRuntimeAssembly)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Retries="$(CopyRetryCount)"
          RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
          Condition="'@(_LibreHardwareMonitorDebugRuntimeAssembly)' != ''" />
  </Target>

  <!-- Debug LHM intentionally excludes IPMI/BMC and RAM SPD. Remove stale copies left
       by older Debug builds so runtime probing cannot bind those assemblies by accident. -->
  <Target Name="RemoveLibreHardwareMonitorUnusedDebugRuntimeAssemblies" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' and '$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <_LibreHardwareMonitorUnusedDebugRuntimeAssembly Include="$(TargetDir)RAMSPDToolkit-NDD.dll" />
      <_LibreHardwareMonitorUnusedDebugRuntimeAssembly Include="$(TargetDir)System.Management.dll" />
      <_LibreHardwareMonitorUnusedDebugRuntimeAssembly Include="$(TargetDir)runtimes\win\lib\net10.0\System.Management.dll" />
    </ItemGroup>

    <Delete Files="@(_LibreHardwareMonitorUnusedDebugRuntimeAssembly)"
            TreatErrorsAsWarnings="true" />
  </Target>

  <Target Name="PublishAfterBuild" AfterTargets="Build" Condition="'$(SkipPublishAfterBuild)' != 'true' and ('$(Configuration)' == 'Release' or '$(Configuration)' == 'ReleaseWithDebugging') and '$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <_PublishOutputPath>$(OutputPath)</_PublishOutputPath>
      <_PublishOutputPath Condition="'$(TrayAppDotNETAggregateBuild)' == 'true'">$(IntermediateOutputPath)native-publish\</_PublishOutputPath>
    </PropertyGroup>
    <Message Importance="High" Text="Publishing Native AOT release..." />
    <RemoveDir Directories="$(_PublishOutputPath)" Condition="Exists('$(_PublishOutputPath)')" ContinueOnError="WarnAndContinue" />
    <MakeDir Directories="$(_PublishOutputPath)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -r win-x64 -o &quot;$(_PublishOutputPath).&quot; -p:SkipPublishAfterBuild=true $(TrayAppDotNETPublishAggregateProperties) -p:SkipKillRunningInstance=$(SkipKillRunningInstance)" />
    <RemoveDir Directories="$(_PublishOutputPath)win-x64" Condition="Exists('$(_PublishOutputPath)win-x64')" ContinueOnError="WarnAndContinue" />
    <ItemGroup Condition="'$(TrayAppDotNETAggregateBuild)' == 'true'">
      <_AggregatePublishedFile Include="$(_PublishOutputPath)**\*" Exclude="$(_PublishOutputPath)native\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AggregatePublishedFile)" DestinationFiles="@(_AggregatePublishedFile->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Retries="$(CopyRetryCount)" RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)" ContinueOnError="WarnAndContinue" Condition="'$(TrayAppDotNETAggregateBuild)' == 'true' and '@(_AggregatePublishedFile)' != ''" />
    <Message Importance="High" Text="Published to $(OutputPath)" />
  </Target>
</Project>
