<Window
    x:Class="FanControlTrayAppDotNET.UI.Curves.FanCurveEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="Fan Curve"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="Transparent">

    <Window.Resources>
        <!-- Window geometry -->
        <sys:Double x:Key="FanCurveEditor.WindowWidth">880</sys:Double>
        <sys:Double x:Key="FanCurveEditor.WindowHeight">650</sys:Double>
        <sys:Double x:Key="FanCurveEditor.WindowMinWidth">820</sys:Double>
        <sys:Double x:Key="FanCurveEditor.WindowMinHeight">500</sys:Double>

        <!-- Curve graph -->
        <sys:Double x:Key="FanCurveEditor.GraphWidth">500</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphHeight">270</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphYAxisLabelGap">2</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphXAxisHeight">24</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphPlotInsetX">10</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphPlotInsetY">8</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphThumbSize">14</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphThumbHitPadding">7</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphLabelFontSize">11</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphVerticalGridDivisions">5</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphHorizontalGridDivisions">5</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphKeyboardStepFinePixels">1</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphKeyboardStepCoarsePixels">10</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphMinimumMeasureWidth">360</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphMinimumMeasureHeight">180</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphDefaultMeasureWidth">540</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphDefaultMeasureHeight">270</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphLegendInset">6</sys:Double>
        <sys:Double x:Key="FanCurveEditor.GraphLegendGap">4</sys:Double>

        <!-- Data source selector -->
        <sys:Double x:Key="FanCurveEditor.LeftColumnWidth">340</sys:Double>
        <sys:Double x:Key="FanCurveEditor.DataSourceSelectionBoxHeight">32</sys:Double>
        <sys:Double x:Key="FanCurveEditor.DataSourceSelectionFontSize">14</sys:Double>
        <sys:Double x:Key="FanCurveEditor.DataSourceListHeight">NaN</sys:Double>
        <sys:Double x:Key="FanCurveEditor.DataSourceSearchBoxHeight">32</sys:Double>
        <sys:Double x:Key="FanCurveEditor.DataSourceClearButtonWidth">32</sys:Double>
        <sys:Double x:Key="FanCurveEditor.DataSourceClearButtonHeight">32</sys:Double>
        <sys:Double x:Key="FanCurveEditor.DataSourceClearButtonFontSize">10</sys:Double>
        <sys:Double x:Key="FanCurveEditor.DataSourceListItemFontSize">13</sys:Double>

        <!-- Curve control cards -->
        <sys:Double x:Key="FanCurveEditor.ControlGridCardWidth">196</sys:Double>
        <sys:Double x:Key="FanCurveEditor.ControlGridWideCardWidth">276</sys:Double>
        <sys:Double x:Key="FanCurveEditor.ControlGridCardMinHeight">0</sys:Double>
        <sys:Double x:Key="FanCurveEditor.MinRPMNumberBoxMinWidth">110</sys:Double>
        <sys:Double x:Key="FanCurveEditor.MaxRPMNumberBoxMinWidth">110</sys:Double>
        <sys:Double x:Key="FanCurveEditor.MinDutyNumberBoxMinWidth">64</sys:Double>
        <sys:Double x:Key="FanCurveEditor.MaxDutyNumberBoxMinWidth">64</sys:Double>
        <sys:Double x:Key="FanCurveEditor.SmoothnessNumberBoxMinWidth">64</sys:Double>
        <sys:Double x:Key="FanCurveEditor.TitleFontSize">16</sys:Double>
        <sys:Double x:Key="FanCurveEditor.RowLabelWidth">86</sys:Double>
        <sys:Double x:Key="FanCurveEditor.RescaleCurveButtonHeight">28</sys:Double>
        <sys:Double x:Key="FanCurveEditor.RescaleCurveButtonFontSize">12</sys:Double>

        <!-- Window and card chrome -->
        <Thickness x:Key="FanCurveEditor.RootBorderThickness">1</Thickness>
        <CornerRadius x:Key="FanCurveEditor.RootCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="FanCurveEditor.CardCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="FanCurveEditor.ZeroCornerRadius">0</CornerRadius>
        <Thickness x:Key="FanCurveEditor.ZeroThickness">0</Thickness>
        <Thickness x:Key="FanCurveEditor.TitleMargin">16,14,16,6</Thickness>
        <Thickness x:Key="FanCurveEditor.MainMargin">16,4,16,16</Thickness>

        <!-- Data source selector layout -->
        <Thickness x:Key="FanCurveEditor.DataSourceTitleMargin">0</Thickness>
        <Thickness x:Key="FanCurveEditor.DataSourceSelectionBoxMargin">0,0,0,0</Thickness>
        <Thickness x:Key="FanCurveEditor.DataSourceSelectionBoxPadding">12,0</Thickness>
        <Thickness x:Key="FanCurveEditor.DataSourceListMargin">0,6,0,0</Thickness>
        <Thickness x:Key="FanCurveEditor.DataSourceSearchBoxPadding">6,0</Thickness>
        <Thickness x:Key="FanCurveEditor.DataSourceClearButtonMargin">4,0,0,0</Thickness>
        <Thickness x:Key="FanCurveEditor.DataSourceSearchRowMargin">0,0,0,4</Thickness>
        <Thickness x:Key="FanCurveEditor.DataSourceListBorderThickness">1</Thickness>
        <Thickness x:Key="FanCurveEditor.DataSourceListContentMargin">4,4,22,2</Thickness>
        <Thickness x:Key="FanCurveEditor.DataSourceListItemPadding">8,5</Thickness>
        <Thickness x:Key="FanCurveEditor.DataSourceListItemMargin">0,0,0,2</Thickness>

        <!-- Curve control card layout -->
        <Thickness x:Key="FanCurveEditor.ControlGridMargin">0</Thickness>
        <Thickness x:Key="FanCurveEditor.ControlGridCardMargin">0,0,2,2</Thickness>
        <Thickness x:Key="FanCurveEditor.ControlGridTitleMargin">0,0,8,0</Thickness>
        <Thickness x:Key="FanCurveEditor.ControlGridControlMargin">0,0,6,0</Thickness>
        <Thickness x:Key="FanCurveEditor.ControlGridNumberBoxMargin">0</Thickness>
        <Thickness x:Key="FanCurveEditor.RescaleCurveButtonMargin">0,8,6,0</Thickness>
        <Thickness x:Key="FanCurveEditor.ToggleMargin">0,0,8,0</Thickness>
        <Thickness x:Key="FanCurveEditor.CardPadding">10,8,4,8</Thickness>
        <Thickness x:Key="FanCurveEditor.CardMargin">0,0,0,6</Thickness>
        <Thickness x:Key="FanCurveEditor.RescaleCurveButtonPadding">0</Thickness>

        <!-- Data source selector corner radii -->
        <CornerRadius x:Key="FanCurveEditor.DataSourceSelectionBoxCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="FanCurveEditor.DataSourceListCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="FanCurveEditor.DataSourceListItemCornerRadius">3</CornerRadius>
    </Window.Resources>
</Window>
