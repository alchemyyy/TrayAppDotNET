<Window
    x:Class="FanControlTrayAppDotNET.UI.Flyout.ProbeDataSelectorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="Probe Data Selector"
    Width="{DynamicResource ProbeSelector.WindowWidth}"
    Height="{DynamicResource ProbeSelector.WindowHeight}"
    MinWidth="{DynamicResource ProbeSelector.WindowWidth}"
    MinHeight="{DynamicResource ProbeSelector.WindowHeight}"
    MaxWidth="{DynamicResource ProbeSelector.WindowWidth}"
    MaxHeight="{DynamicResource ProbeSelector.WindowHeight}"
    CanResize="False"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Window and tab geometry -->
        <sys:Double x:Key="ProbeSelector.WindowWidth">962</sys:Double>
        <sys:Double x:Key="ProbeSelector.WindowHeight">500</sys:Double>
        <sys:Double x:Key="ProbeSelector.TabRowHeight">28</sys:Double>
        <sys:Double x:Key="ProbeSelector.TabWidth">116</sys:Double>
        <sys:Double x:Key="ProbeSelector.TabFontSize">13</sys:Double>
        <sys:Double x:Key="ProbeSelector.TabMinHeight">24</sys:Double>

        <!-- Probe cards -->
        <sys:Double x:Key="ProbeSelector.CardTitleFontSize">12</sys:Double>
        <sys:Double x:Key="ProbeSelector.CardValueFontSize">11</sys:Double>
        <sys:Double x:Key="ProbeSelector.ValueGlyphWidth">16</sys:Double>
        <sys:Double x:Key="ProbeSelector.ValueGlyphFontSize">12</sys:Double>
        <sys:Double x:Key="ProbeSelector.GridCardWidth">464</sys:Double>
        <sys:Double x:Key="ProbeSelector.EmptyStateFontSize">12</sys:Double>
        <sys:Double x:Key="ProbeSelector.SectionTitleFontSize">13</sys:Double>
        <sys:Double x:Key="ProbeSelector.ActionButtonWidth">36</sys:Double>
        <sys:Double x:Key="ProbeSelector.ActionButtonHeight">36</sys:Double>
        <sys:Double x:Key="ProbeSelector.ActionButtonGlyphFontSize">18</sys:Double>
        <sys:Double x:Key="ProbeSelector.TransformActionButtonInactiveGlyphOpacity">0.45</sys:Double>

        <!-- Transform controls -->
        <sys:Double x:Key="ProbeSelector.TruncateToggleFontSize">10</sys:Double>
        <sys:Double x:Key="ProbeSelector.TruncateToggleWidth">100</sys:Double>
        <sys:Double x:Key="ProbeSelector.TruncateToggleTrackWidth">32</sys:Double>
        <sys:Double x:Key="ProbeSelector.TruncateToggleTrackHeightRatio">0.5</sys:Double>
        <sys:Double x:Key="ProbeSelector.TruncateToggleThumbSizeRatio">0.3333333333333333</sys:Double>
        <sys:Double x:Key="ProbeSelector.TransformLabelFontSize">10</sys:Double>
        <sys:Double x:Key="ProbeSelector.TransformInlineBoxWidth">132</sys:Double>
        <sys:Double x:Key="ProbeSelector.TransformBoxHeight">24</sys:Double>
        <sys:Double x:Key="ProbeSelector.TransformBoxMinHeight">0</sys:Double>

        <!-- Home actions -->
        <sys:Double x:Key="ProbeSelector.HomeClearDeadSensorsButtonWidth">132</sys:Double>
        <sys:Double x:Key="ProbeSelector.HomeLoadDefaultNicknamesButtonWidth">170</sys:Double>
        <sys:Double x:Key="ProbeSelector.HomeActionButtonHeight">28</sys:Double>
        <sys:Double x:Key="ProbeSelector.HomeDeviceNicknamesRowHeight">220</sys:Double>
        <sys:Double x:Key="ProbeSelector.HomeSectionSeparatorThickness">1</sys:Double>

        <!-- Device nickname editor -->
        <sys:Double x:Key="ProbeSelector.NicknameCardWidth">446</sys:Double>
        <sys:Double x:Key="ProbeSelector.NicknameAddButtonWidth">64</sys:Double>
        <sys:Double x:Key="ProbeSelector.NicknameAddButtonHeight">28</sys:Double>
        <sys:Double x:Key="ProbeSelector.NicknameTargetTextBoxWidth">286</sys:Double>
        <sys:Double x:Key="ProbeSelector.NicknameReplacementTextBoxWidth">90</sys:Double>
        <sys:Double x:Key="ProbeSelector.NicknameTextBoxHeight">30</sys:Double>
        <sys:Double x:Key="ProbeSelector.NicknameArrowFontSize">13</sys:Double>
        <sys:Double x:Key="ProbeSelector.NicknameDeleteButtonWidth">26</sys:Double>
        <sys:Double x:Key="ProbeSelector.NicknameDeleteButtonHeight">24</sys:Double>
        <sys:Double x:Key="ProbeSelector.NicknameDeleteButtonFontSize">10</sys:Double>

        <!-- Reorder feedback and enabled states -->
        <sys:Double x:Key="ProbeSelector.ReorderDragThreshold">4</sys:Double>
        <sys:Double x:Key="ProbeSelector.ReorderDraggingOpacity">0.82</sys:Double>
        <sys:Int32 x:Key="ProbeSelector.ReorderDraggingZIndex">1</sys:Int32>
        <sys:Int32 x:Key="ProbeSelector.ReorderNormalZIndex">0</sys:Int32>
        <sys:Double x:Key="ProbeSelector.ControlDisabledOpacity">0.45</sys:Double>
        <sys:Double x:Key="ProbeSelector.FullOpacity">1</sys:Double>

        <!-- Window, tabs, and cards -->
        <Thickness x:Key="ProbeSelector.ZeroThickness">0</Thickness>
        <Thickness x:Key="ProbeSelector.RootBorderThickness">1</Thickness>
        <Thickness x:Key="ProbeSelector.ContentMargin">4</Thickness>
        <Thickness x:Key="ProbeSelector.TabMargin">0,0,2,0</Thickness>
        <Thickness x:Key="ProbeSelector.TabPadding">2,0</Thickness>
        <Thickness x:Key="ProbeSelector.BodyMargin">0,4,0,0</Thickness>
        <Thickness x:Key="ProbeSelector.CardMargin">0,0,4,4</Thickness>
        <Thickness x:Key="ProbeSelector.CardPadding">6,5</Thickness>
        <Thickness x:Key="ProbeSelector.TextColumnMargin">0,0,4,0</Thickness>
        <Thickness x:Key="ProbeSelector.ValueRowMargin">0,-2,0,0</Thickness>
        <Thickness x:Key="ProbeSelector.ValueGlyphMargin">0,0,0,0</Thickness>
        <Thickness x:Key="ProbeSelector.ActionButtonMargin">0,0,-2,0</Thickness>
        <Thickness x:Key="ProbeSelector.ProbeControlRowMargin">8,0,0,0</Thickness>
        <Thickness x:Key="ProbeSelector.ProbeToggleColumnMargin">8,-4,0,-2</Thickness>

        <!-- Transform layout -->
        <Thickness x:Key="ProbeSelector.TruncateToggleMargin">0,2,-12,0</Thickness>
        <Thickness x:Key="ProbeSelector.TruncateToggleLabelMargin">4,0,0,0</Thickness>
        <Thickness x:Key="ProbeSelector.TransformRowMargin">0,6,0,0</Thickness>
        <Thickness x:Key="ProbeSelector.TransformLabelMargin">2,0,1,0</Thickness>
        <Thickness x:Key="ProbeSelector.TransformBoxPadding">4,0</Thickness>

        <!-- Home layout -->
        <Thickness x:Key="ProbeSelector.HomeActionButtonMargin">0,0,6,0</Thickness>
        <Thickness x:Key="ProbeSelector.HomeActionButtonTrailingMargin">0,0,4,0</Thickness>
        <Thickness x:Key="ProbeSelector.HomeActionButtonPadding">6,0</Thickness>
        <Thickness x:Key="ProbeSelector.HomeNicknameColumnPadding">8,0,8,0</Thickness>
        <Thickness x:Key="ProbeSelector.HomeColumnSeparatorMargin">0</Thickness>
        <Thickness x:Key="ProbeSelector.HomeNicknameRowSeparatorMargin">0</Thickness>
        <Thickness x:Key="ProbeSelector.HomeSectionScrollHostMargin">0,0,-10,0</Thickness>
        <Thickness x:Key="ProbeSelector.HomeNicknameScrollHostMargin">-8,0,-16,0</Thickness>
        <Thickness x:Key="ProbeSelector.SelectedProbeGridMargin">0,6,0,0</Thickness>

        <!-- Nickname layout -->
        <Thickness x:Key="ProbeSelector.NicknameCardPadding">6,5,0,5</Thickness>
        <Thickness x:Key="ProbeSelector.NicknameSectionMargin">0,8,0,0</Thickness>
        <Thickness x:Key="ProbeSelector.SectionHeaderMargin">0,4,8,4</Thickness>
        <Thickness x:Key="ProbeSelector.NicknameListMargin">0</Thickness>
        <Thickness x:Key="ProbeSelector.NicknameListPadding">0,6,0,0</Thickness>
        <Thickness x:Key="ProbeSelector.NicknameAddButtonPadding">0</Thickness>
        <Thickness x:Key="ProbeSelector.NicknameTextBoxPadding">4,0</Thickness>
        <Thickness x:Key="ProbeSelector.NicknameArrowMargin">4,0,4,0</Thickness>
        <Thickness x:Key="ProbeSelector.NicknameDeleteButtonMargin">4,0,0,0</Thickness>

        <!-- Corner radii and separator color -->
        <CornerRadius x:Key="ProbeSelector.RootCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="ProbeSelector.CardCornerRadius">5</CornerRadius>
        <CornerRadius x:Key="ProbeSelector.TabCornerRadius">5,5,0,0</CornerRadius>
        <CornerRadius x:Key="ProbeSelector.ZeroCornerRadius">0</CornerRadius>

        <sys:String x:Key="ProbeSelector.HomeSectionSeparatorColor">#E8E8E8</sys:String>
    </Window.Resources>
</Window>
