<Window
    x:Class="FanControlTrayAppDotNET.UI.Flyout.FanPropertiesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="Fan Properties"
    WindowDecorations="BorderOnly"
    ExtendClientAreaToDecorationsHint="True"
    CanResize="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="True"
    ShowActivated="False">

    <Window.Resources>
        <!-- Window geometry -->
        <sys:Double x:Key="FanProperties.WindowWidth">800</sys:Double>
        <sys:Double x:Key="FanProperties.WindowHeight">500</sys:Double>
        <sys:Double x:Key="FanProperties.WindowMinWidth">640</sys:Double>
        <sys:Double x:Key="FanProperties.WindowMinHeight">360</sys:Double>
        <sys:Double x:Key="FanProperties.TitleBarHeight">32</sys:Double>
        <sys:Double x:Key="FanProperties.FooterHeight">42</sys:Double>
        <sys:Double x:Key="FanProperties.BodyLeftColumnWidth">400</sys:Double>
        <sys:Double x:Key="FanProperties.RightPreviewMinHeight">220</sys:Double>
        <sys:Double x:Key="FanProperties.TextBoxWidth">230</sys:Double>
        <sys:Double x:Key="FanProperties.CurveComboBoxWidth">200</sys:Double>
        <sys:Double x:Key="FanProperties.NumberBoxWidth">140</sys:Double>
        <sys:Double x:Key="FanProperties.RowLabelColumnWidth">74</sys:Double>

        <!-- RPM mode toggle -->
        <sys:Double x:Key="FanProperties.RPMModeToggleColumnWidth">40</sys:Double>
        <sys:Double x:Key="FanProperties.RPMModeRightInset">8</sys:Double>

        <!-- Typography and enabled states -->
        <sys:Double x:Key="FanProperties.TitleFontSize">13</sys:Double>
        <sys:Double x:Key="FanProperties.RPMModeHeaderFontSize">9</sys:Double>
        <sys:Double x:Key="FanProperties.EnabledOpacity">1</sys:Double>
        <sys:Double x:Key="FanProperties.DisabledOpacity">0.4</sys:Double>

        <!-- Window chrome and layout -->
        <Thickness x:Key="FanProperties.RootBorderThickness">1</Thickness>
        <CornerRadius x:Key="FanProperties.RootCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="FanProperties.InnerCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="FanProperties.ZeroCornerRadius">0</CornerRadius>
        <Thickness x:Key="FanProperties.TitleMargin">12,0,8,0</Thickness>
        <Thickness x:Key="FanProperties.BodyMargin">10,8,10,0</Thickness>
        <Thickness x:Key="FanProperties.LeftMargin">0</Thickness>
        <Thickness x:Key="FanProperties.RightMargin">10,0,0,0</Thickness>
        <Thickness x:Key="FanProperties.CurveControlsMargin">0,8,0,0</Thickness>
        <Thickness x:Key="FanProperties.FooterMargin">10,6,10,10</Thickness>
        <Thickness x:Key="FanProperties.FooterButtonsMargin">74,0,0,0</Thickness>
        <Thickness x:Key="FanProperties.ResetButtonMargin">0,0,8,0</Thickness>
        <Thickness x:Key="FanProperties.RadioButtonMargin">0,0,6,0</Thickness>
        <Thickness x:Key="FanProperties.ZeroThickness">0</Thickness>

        <!-- Property rows -->
        <sys:Double x:Key="FanProperties.ValueFontSize">11</sys:Double>
        <sys:Double x:Key="FanProperties.RadioButtonFontSize">11</sys:Double>
        <sys:Double x:Key="FanProperties.RowLabelFontSize">11</sys:Double>
        <sys:Double x:Key="FanProperties.RowBottomMargin">5</sys:Double>
        <sys:Double x:Key="FanProperties.RPMModeHeaderBottomMargin">2</sys:Double>
        <sys:Double x:Key="FanProperties.OffsetRowBottomMargin">2</sys:Double>

        <!-- Caption buttons -->
        <sys:Double x:Key="FanProperties.CaptionButtonWidth">46</sys:Double>
        <sys:Double x:Key="FanProperties.CaptionButtonHeight">32</sys:Double>
        <sys:Double x:Key="FanProperties.CaptionButtonGlyphFontSize">10</sys:Double>
        <Thickness x:Key="FanProperties.CaptionButtonPadding">0</Thickness>
    </Window.Resources>
</Window>
