<ResourceDictionary
    x:Class="FanControlTrayAppDotNET.UI.Flyout.FanFlyoutCellResources"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Group slider values -->
    <sys:Int32 x:Key="FanFlyoutCell.GroupFanDisplayedValueSlotWidth">44</sys:Int32>
    <sys:Int32 x:Key="FanFlyoutCell.GroupRPMDisplayedValueSlotWidth">84</sys:Int32>
    <sys:Int32 x:Key="FanFlyoutCell.GroupFanSliderMaximum">100</sys:Int32>
</ResourceDictionary>
