<Project>
  <PropertyGroup>
    <CopyRetryCount Condition="'$(CopyRetryCount)' == ''">3</CopyRetryCount>
    <CopyRetryDelayMilliseconds Condition="'$(CopyRetryDelayMilliseconds)' == ''">500</CopyRetryDelayMilliseconds>
    <OverwriteReadOnlyFiles Condition="'$(OverwriteReadOnlyFiles)' == ''">true</OverwriteReadOnlyFiles>
    <ErrorOnDuplicatePublishOutputFiles Condition="'$(ErrorOnDuplicatePublishOutputFiles)' == ''">false</ErrorOnDuplicatePublishOutputFiles>
    <TrayAppDotNETUnlockScript Condition="'$(TrayAppDotNETUnlockScript)' == ''">$(TrayAppDotNETRoot).tadn_build_tools\unlock_trayappdotnet_build_outputs.ps1</TrayAppDotNETUnlockScript>
    <TrayAppDotNETUnlockMaxAttempts Condition="'$(TrayAppDotNETUnlockMaxAttempts)' == ''">4</TrayAppDotNETUnlockMaxAttempts>
    <TrayAppDotNETUnlockRetryDelayMilliseconds Condition="'$(TrayAppDotNETUnlockRetryDelayMilliseconds)' == ''">500</TrayAppDotNETUnlockRetryDelayMilliseconds>
    <TrayAppDotNETUnlockProcessNames Condition="'$(TrayAppDotNETUnlockProcessNames)' == ''">BatteryTrayAppDotNET;BrightnessTrayAppDotNET;FanControlTrayAppDotNET;NetworkTrayAppDotNET;VolumeTrayAppDotNET</TrayAppDotNETUnlockProcessNames>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TrayAppDotNETUseRootOutput)' == 'true'">
    <TrayAppDotNETOutputRoot Condition="'$(TrayAppDotNETOutputRoot)' == ''">$(TrayAppDotNETRoot)bin\</TrayAppDotNETOutputRoot>
    <OutDir>$(TrayAppDotNETOutputRoot)$(Configuration)\</OutDir>
    <OutputPath>$(OutDir)</OutputPath>
    <GenerateProjectSpecificOutputFolder>false</GenerateProjectSpecificOutputFolder>
    <UseCommonOutputDirectory>true</UseCommonOutputDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TrayAppDotNETAggregateBuild)' == 'true'">
    <!-- Aggregate publish runs a separate dotnet process, so it must carry x64 explicitly.
         Without this, inner publish can resolve shared reference assemblies from obj\Release
         instead of obj\x64\Release and compile against stale TrayAppDotNETCommon metadata. -->
    <TrayAppDotNETPublishAggregateProperties Condition="'$(TrayAppDotNETPublishAggregateProperties)' == ''">-p:Platform=x64 -p:TrayAppDotNETAggregateBuild=true -p:TrayAppDotNETUseRootOutput=true -p:TrayAppDotNETBuildSharedProjectReferences=false -p:TrayAppDotNETOutputRoot=&quot;$(TrayAppDotNETOutputRoot)\&quot;</TrayAppDotNETPublishAggregateProperties>
  </PropertyGroup>

  <Target Name="BuildTrayAppDotNETSharedReferencesBeforeAggregateResolve"
          BeforeTargets="ResolveProjectReferences"
          Condition="'$(TrayAppDotNETAggregateBuild)' == 'true' and '$(TrayAppDotNETBuildSharedProjectReferences)' == 'false' and '$(OutputType)' == 'WinExe' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_TrayAppDotNETSharedReferenceProject Include="$(TrayAppDotNETCommonRoot)\generators\XmlSourceGenerator\TrayAppDotNETCommon.XmlSourceGenerator.csproj" />
      <_TrayAppDotNETSharedReferenceProject Include="$(TrayAppDotNETCommonRoot)\generators\AxamlPropertyLinker\TrayAppDotNETCommon.AxamlPropertyLinker.csproj" />
      <_TrayAppDotNETSharedReferenceProject Include="$(TrayAppDotNETCommonProject)" />
    </ItemGroup>

    <MSBuild Projects="@(_TrayAppDotNETSharedReferenceProject)"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=x64;TrayAppDotNETAggregateBuild=true;TrayAppDotNETUseRootOutput=true;TrayAppDotNETBuildSharedProjectReferences=true;TrayAppDotNETOutputRoot=$(TrayAppDotNETOutputRoot);SkipKillRunningInstance=$(SkipKillRunningInstance)"
             RemoveProperties="PublishAot;SelfContained;RuntimeIdentifier;RuntimeIdentifiers;PublishSingleFile;IncludeNativeLibrariesForSelfExtract;IncludeAllContentForSelfExtract;UseAppHost;OutputPath;OutDir;PublishDir" />
  </Target>

  <PropertyGroup Condition="'$(OutputType)' == 'WinExe'">
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TrayAppDotNETDefaultGCHeapHardLimitBytes>104857600</TrayAppDotNETDefaultGCHeapHardLimitBytes>
    <TrayAppDotNETDefaultGCHeapHardLimitBytes Condition="'$(MSBuildProjectName)' == 'FanControlTrayAppDotNET'">157286400</TrayAppDotNETDefaultGCHeapHardLimitBytes>
    <TrayAppDotNETGCHeapHardLimitBytes Condition="'$(TrayAppDotNETGCHeapHardLimitBytes)' == ''">$(TrayAppDotNETDefaultGCHeapHardLimitBytes)</TrayAppDotNETGCHeapHardLimitBytes>
  </PropertyGroup>

  <ItemGroup Condition="'$(OutputType)' == 'WinExe'">
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="$(TrayAppDotNETGCHeapHardLimitBytes)" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <!-- Probe output files for write access and only kill TrayAppDotNET PIDs
       that Restart Manager reports as locking those files. -->
  <Target Name="UnlockTrayAppDotNETOutputFilesBeforeBuild"
          BeforeTargets="BeforeBuild;BeforeClean"
          Condition="'$(SkipKillRunningInstance)' != 'true' and '$(OutputType)' == 'WinExe' and Exists('$(TrayAppDotNETUnlockScript)')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(TrayAppDotNETUnlockScript)&quot; -OutputDirectories &quot;$(TargetDir).;$(OutDir).;$(OutputPath).&quot; -AllowedProcessNames &quot;$(TrayAppDotNETUnlockProcessNames)&quot; -MaxAttempts $(TrayAppDotNETUnlockMaxAttempts) -RetryDelayMilliseconds $(TrayAppDotNETUnlockRetryDelayMilliseconds)" />
  </Target>

  <Target Name="UnlockTrayAppDotNETOutputFilesBeforePostBuildCopy"
          BeforeTargets="CopyHotAvaloniaRuntimeAssemblies;CopyRuntimeReferencesToAggregateDebugOutput;CopyLibreHardwareMonitorDebugRuntimeAssemblies;PublishAfterBuild"
          Condition="'$(SkipKillRunningInstance)' != 'true' and '$(OutputType)' == 'WinExe' and Exists('$(TrayAppDotNETUnlockScript)')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(TrayAppDotNETUnlockScript)&quot; -OutputDirectories &quot;$(TargetDir).;$(OutDir).;$(OutputPath).&quot; -AllowedProcessNames &quot;$(TrayAppDotNETUnlockProcessNames)&quot; -MaxAttempts $(TrayAppDotNETUnlockMaxAttempts) -RetryDelayMilliseconds $(TrayAppDotNETUnlockRetryDelayMilliseconds)" />
  </Target>
</Project>
