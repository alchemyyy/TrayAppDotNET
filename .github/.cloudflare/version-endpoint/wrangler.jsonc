{
  "name": "trayapp-version-endpoint",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "version.trayapp.net",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
