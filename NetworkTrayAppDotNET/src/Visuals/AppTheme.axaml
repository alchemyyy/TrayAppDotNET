<ResourceDictionary
    x:Class="NetworkTrayAppDotNET.Visuals.AppThemeResources"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:visuals="clr-namespace:TrayAppDotNETCommon.Visuals;assembly=TrayAppDotNETCommon">

    <visuals:ThemeColor x:Key="NetworkAppTheme.NetworkConnectedTrayIconColor" LightHex="#000000" DarkHex="#FFFFFF" />
    <visuals:ThemeColor x:Key="NetworkAppTheme.NetworkNoInternetTrayIconColor" LightHex="#996600" DarkHex="#FFB900" />
    <visuals:ThemeColor x:Key="NetworkAppTheme.NetworkDisconnectedTrayIconColor" LightHex="#666666" DarkHex="#808080" />
</ResourceDictionary>
